// The fleet: each station with its vehicles; a vehicle's card.
use BuildingRow, UnitRow, Ack from "./model.contract"
use Icon from "./icons.contract"
use Tag, CallSign, Heading, Empty, Meter from "./parts.contract"
use Mono, Caps, Secondary, Quiet, statusColor, plural from "./theme.contract"
use serviceColor, kindColor from "./palette.contract"

fn statusTone(code: number): string = code == 1 ? "#3fb950" : code == 3 ? "#f2555a" : code == 2 ? "#f0a531" : code == 6 ? "#9aa4b2" : code == 7 ? "#58a6ff" : code == 8 ? "#808b9c" : "#b48ef0"

fn gaugeColor(v: number): string = v > 90 ? "#f2555a" : v > 70 ? "#f0a531" : "#9aa4b2"

// A radio status as the console shows it: the number on its colour.
component StatusCode
  props
    code: number
    label: string
  view
    row gap=6 align-items="center" flex-shrink=0
      view width="1.25rem" height="1.25rem" background-color=statusTone(code) display="flex" align-items="center" justify-content="center"
        text `${code}` class=Mono font-size="0.7rem" font-weight=600 color="#0b0e12"
      text label class=Mono font-size="0.68rem" color="#9aa4b2" white-space="nowrap"

component Fleet
  props
    buildings: BuildingRow[]
    units: UnitRow[]
    pickBuilding: action
    pickUnit: action
  view
    column role="tabpanel" id="panel-flotte" gap=14
      if buildings.length == 0
        Empty(icon="build", text="Aucun bâtiment. La première caserne est offerte, avec un VSAV.")
      for b in buildings key=b.id
        column
          button press=pickBuilding(b.id) appearance="none" display="flex" align-items="center" gap=8 padding="6px 4px" border-bottom="1px solid #30394a" testId=`building-${b.id}`
            Icon(name=b.kind, size=15, color=kindColor(b.kind))
            text b.name font-weight=600 font-size="0.84rem" flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left"
            text `${b.used}/${b.slots}` class=Mono font-size="0.7rem" color="#9aa4b2"
          for u in units.filter(x => x.building == b.id) key=u.id
            row press=pickUnit(u.id) role="button" aria-label=`${u.name}, statut ${u.statusCode}, ${u.statusLabel}` gap=8 align-items="center" padding="6px 4px" border-bottom="1px solid #1a2029" testId=`unit-${u.id}`
              text u.name class=Mono font-size="0.78rem" font-weight=600 width="4.6rem" color=serviceColor(u.service)
              StatusCode(code=u.statusCode, label=u.statusLabel)
              text (u.callTitle != "" ? u.callTitle : "") font-size="0.72rem" color="#808b9c" flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
              if u.eta != ""
                text u.eta class=Mono font-size="0.68rem" color="#9aa4b2"
              // Crew fatigue at a glance.
              view width="2rem" flex-shrink=0 aria-label=`Fatigue ${u.fatigue} %`
                Meter(fraction=u.fatigue / 100, color=gaugeColor(u.fatigue))

component UnitCard
  props
    u: UnitRow
    dismiss: action
    see: action
    posted: action
  mutation done as shape Ack queue
  action recall
    send done = recallUnit(u.id)
  action sell
    send done = sellVehicle(u.id)
    dismiss()
  action rest
    send done = restUnit(u.id)
  action post
    send done = postUnit(u.id)
    posted()
  action standDown
    send done = standDown(u.id)
  action service
    send done = serviceUnit(u.id)
  view
    column gap=10 testId="unit-card"
      row align-items="center" gap=10
        CallSign(label=u.type, service=u.service, color=serviceColor(u.service))
        column flex=1 min-width=0
          text u.name class=Mono font-weight=600
          text u.long font-size="0.75rem" color="#9aa4b2"
        button press=dismiss aria-label="Fermer" class=Quiet testId="unit-close"
          Icon(name="close", size=16, color="#9aa4b2")
      row gap=8 align-items="center" flex-wrap="wrap"
        StatusCode(code=u.statusCode, label=u.statusLabel)
        if u.eta != ""
          text `arrivée ${u.eta}` class=Mono font-size="0.75rem" color="#9aa4b2"
        if u.waitText != ""
          text u.waitText class=Mono font-size="0.75rem" color="#9aa4b2"
      if u.callTitle != ""
        text `Mission : ${u.callTitle}` font-size="0.85rem"
      // Crew and vehicle condition.
      column gap=6 testId="unit-condition"
        row gap=8 align-items="center"
          text "Fatigue" class=Caps width="4.5rem"
          view flex=1
            Meter(fraction=u.fatigue / 100, color=gaugeColor(u.fatigue))
          text `${u.fatigue} %` class=Mono font-size="0.72rem" width="2.6rem" text-align="right" color=gaugeColor(u.fatigue)
        row gap=8 align-items="center"
          text "Usure" class=Caps width="4.5rem"
          view flex=1
            Meter(fraction=u.wear / 100, color=gaugeColor(u.wear))
          text `${u.wear} %` class=Mono font-size="0.72rem" width="2.6rem" text-align="right" color=gaugeColor(u.wear)
        if u.tired
          text (u.fatigue > 90 ? "Équipage épuisé : il roule et travaille moins vite. Mettez-le au repos." : "Équipage fatigué : il roule et travaille moins vite.") font-size="0.78rem" color="#f0a531" line-height=1.4
      text `${u.buildingName} · ${plural(u.missions, "mission", "missions")}` class=Caps
      row gap=8 flex-wrap="wrap"
        button press=see class=Secondary flex="1 1 40%" testId="unit-focus"
          Icon(name="target", size=14, color="#e6edf3")
          text "Voir"
        if u.status == "route"
          button press=recall class=Secondary flex="1 1 40%" white-space="nowrap" testId="unit-recall"
            text "Désengager"
        if u.canPost
          button press=post class=Secondary flex="1 1 40%" white-space="nowrap" testId="unit-post"
            Icon(name="target", size=14, color="#e6edf3")
            text (u.canStandDown ? "Déplacer" : "Prépositionner")
        if u.canStandDown
          button press=standDown class=Secondary flex="1 1 40%" white-space="nowrap" testId="unit-home"
            text "Rentrer à la base"
        if u.canRest
          button press=rest class=Secondary flex="1 1 40%" white-space="nowrap" testId="unit-rest"
            text "Au repos"
        if u.canService
          button press=service class=Secondary flex="1 1 40%" white-space="nowrap" testId="unit-service"
            text `Réviser ${u.servicePrice}`
        if u.canSell
          button press=sell class=Secondary flex="1 1 40%" white-space="nowrap" testId="unit-sell"
            Icon(name="sell", size=14, color="#e6edf3")
            text `Vendre ${u.resale}`
