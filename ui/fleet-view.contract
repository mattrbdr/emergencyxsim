// The fleet view: every station and its vehicles on the left, the one selected
// on the right (garage, upgrades and shop; or a vehicle's condition).
use BuildingRow, UnitRow from "./model.contract"
use Icon from "./icons.contract"
use Heading, Empty, Meter from "./parts.contract"
use Mono, Caps, Row, Quiet, plural from "./theme.contract"
use serviceColor, kindColor from "./palette.contract"
use StatusCode, UnitCard from "./fleet.contract"
use BuildingSheet from "./build.contract"

fn gauge(v: number): string = v > 90 ? "#f2555a" : v > 70 ? "#f0a531" : "#4b5668"
fn keep(u: UnitRow, f: string): bool = f == "tous" ? true : f == "dispo" ? u.status == "dispo" : f == "fatigues" ? u.tired : u.status == "atelier" or u.status == "repos"
fn filterLabel(f: string): string = f == "tous" ? "Tous" : f == "dispo" ? "Dispo" : f == "fatigues" ? "Fatigués" : "Indispo"

component FleetView
  props
    buildings: BuildingRow[]
    units: UnitRow[]
    seq: number
    hint: string
    wide: bool
    pushed: bool
    upkeep: string
    sel: string
    toMap: action
    pick: action
    showOnMap: action
  state filter = "tous"
  derive selKind = sel.startsWith("b-") ? "building" : sel.startsWith("u-") ? "unit" : ""
  derive selId = sel.slice(2)
  action back
    pick("")
  action setFilter(f: string)
    filter = f
  action seeOnMap
    showOnMap(selId)
  view
    row gap=20 align-items="stretch" max-width="72rem" width="100%" margin="0 auto" height="100%" testId="fleet-view"
      if (wide or sel == "") and not pushed
        // A native grouped list (UIKit's on iOS): the totals, then one section per station.
        list id="fleet" appearance="auto" listStyle="inset-grouped" flex=(wide ? "1 1 0" : 1) min-width=0 min-height=0
          section background-color="transparent"
            column gap=10
              text plural(units.length, "véhicule", "véhicules") font-size="1.15rem" font-weight=600 role="heading" aria-level=2
              row gap=8 flex-wrap="wrap"
                Count(label="Disponibles", n=units.filter(u => u.status == "dispo").length, color="#3fb950")
                Count(label="En intervention", n=units.filter(u => u.status == "route" or u.status == "surplace" or u.status == "transport" or u.status == "hopital").length, color="#f0a531")
                Count(label="Repos", n=units.filter(u => u.status == "repos").length, color="#58a6ff")
                Count(label="Atelier", n=units.filter(u => u.status == "atelier").length, color="#808b9c")
              text (upkeep.startsWith("Entretien") ? upkeep : `Entretien total ${upkeep}`) class=Mono font-size="0.72rem" color="#9aa4b2"
              row role="radiogroup" aria-label="Filtrer les véhicules" align-self="stretch"
                for f in ["tous", "dispo", "fatigues", "repos"] key=f
                  button role="radio" aria-checked=(filter == f) press=setFilter(f) testId=`fleet-${f}`
                    text filterLabel(f)
          if buildings.length == 0
            section background-color="transparent"
              Empty(icon="build", text="Aucune base. Construisez la première caserne depuis la régulation.")
          for b in buildings key=b.id
            section
              header
                text b.label
              row press=pick(`b-${b.id}`) role="button" gap=10 align-items="center" background-color=(sel == `b-${b.id}` ? "#1a212b" : "transparent") testId=`base-${b.id}`
                Icon(name=b.kind, size=20, color=kindColor(b.kind))
                column flex=1 min-width=0 gap=4
                  text b.name font-weight=600 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                  row gap=10 align-items="center" flex-wrap="wrap" row-gap=4
                    view width="4rem"
                      Meter(fraction=(b.slots > 0 ? b.used / b.slots : 0), color=kindColor(b.kind))
                    text `${b.used}/${b.slots} places` class=Mono font-size="0.68rem" color="#9aa4b2" white-space="nowrap"
                    text `améliorations ${b.upgradesText}` class=Mono font-size="0.68rem" color="#808b9c" white-space="nowrap"
                text b.upkeep class=Mono font-size="0.7rem" color="#9aa4b2" white-space="nowrap"
              for u in units.filter(x => x.building == b.id and keep(x, filter)) key=u.id
                row press=pick(`u-${u.id}`) role="button" aria-label=`${u.name}, ${u.statusLabel}, fatigue ${u.fatigue} %` gap=8 align-items="center" background-color=(sel == `u-${u.id}` ? "#1a212b" : "transparent") testId=`fleet-unit-${u.id}`
                  text u.name class=Mono font-size="0.82rem" font-weight=600 width="4.8rem" color=serviceColor(u.service)
                  StatusCode(code=u.statusCode, label=u.statusLabel)
                  view flex=1
                  view width="3rem" aria-hidden=true
                    Meter(fraction=u.fatigue / 100, color=gauge(u.fatigue))
                  text `${u.fatigue} %` class=Mono font-size="0.66rem" width="2.4rem" text-align="right" color="#808b9c"
      if sel != ""
        scroll flex=(wide ? "0 0 26rem" : 1) min-width=0 min-height=0 padding=(wide ? 16 : 0) background-color=(wide ? "#0e1217" : "transparent") border=(wide ? "1px solid #252c36" : "none") border-radius=4 testId="fleet-detail"
          if not wide and not pushed
            button press=back appearance="none" align-self="flex-start" display="flex" align-items="center" gap=6 padding="4px 0" testId="fleet-back"
              Icon(name="chevron-left", size=14, color="#9aa4b2")
              text "Flotte" font-size="0.82rem" color="#9aa4b2"
          if selKind == "building"
            match first(buildings.filter(b => b.id == selId))
              case some(b)
                BuildingSheet(b=b, seq=seq, close=back, hint=hint)
              case none
                text "Cette base n'existe plus." color="#9aa4b2"
          if selKind == "unit"
            match first(units.filter(u => u.id == selId))
              case some(u)
                UnitCard(u=u, bar=pushed, dismiss=back, see=seeOnMap, posted=toMap)
              case none
                text "Ce véhicule n'est plus en service." color="#9aa4b2"
      else if wide
        column flex="0 0 26rem" align-items="center" justify-content="center" padding=24 border="1px dashed #252c36" border-radius=4 min-height="12rem"
          text "Choisissez une base ou un véhicule." font-size="0.84rem" color="#808b9c"

component Count
  props
    label: string
    n: number
    color: string
  view
    row gap=6 align-items="baseline" padding="6px 10px" background-color="#171c24" border-radius=4
      text `${n}` class=Mono font-size="0.95rem" font-weight=600 color=color
      text label class=Caps font-size="0.6rem"
