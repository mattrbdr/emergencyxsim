// The log ("main courante") on its own page, with filters and the day's bulletin.
use LogLine from "./model.contract"
use Icon from "./icons.contract"
use Heading, Empty from "./parts.contract"
use Mono, Caps, Row, toneColor, plural from "./theme.contract"

fn filterLabel(f: string): string = f == "tout" ? "Tout" : f == "alertes" ? "Alertes" : f == "argent" ? "Argent" : "Succès"

component JournalView
  props
    seq: number
    date: string
    bulletin: string
    weatherIcon: string
  state filter = "tout"
  resource lines = journal(filter, seq) as shape LogLine[] else empty() transient
  action pick(f: string)
    filter = f
  view
    // A native grouped list: the day's bulletin and the filter, then the log's lines.
    list id="journal" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0 max-width="48rem" width="100%" margin="0 auto" testId="journal"
      section background-color="transparent"
        column gap=12
          column gap=2
            text `MAIN COURANTE · ${date.toUpperCase()}` class=Caps
            text "Journal de la garde" font-size="1.15rem" font-weight=600 role="heading" aria-level=2
          row role="radiogroup" aria-label="Filtrer" align-self="stretch"
            for f in ["tout", "alertes", "argent", "succes"] key=f
              button role="radio" aria-checked=(filter == f) press=pick(f) testId=`journal-${f}`
                text filterLabel(f)
      section
        header
          text "Bulletin du jour"
        row gap=10 align-items="flex-start" padding-top=10 padding-bottom=10 testId="journal-bulletin"
          Icon(name=weatherIcon, size=18, color="#c9d1d9")
          text bulletin font-size="0.86rem" line-height=1.45 flex=1
      if lines.length == 0
        section background-color="transparent"
          Empty(icon="log", text="Rien à afficher pour ce filtre.")
      else
        section
          header
            text plural(lines.length, "ligne", "lignes")
          for l in lines key=l.id
            row gap=10 align-items="flex-start" padding-top=8 padding-bottom=8
              view width=3 align-self="stretch" border-radius=2 background-color=toneColor(l.tone)
              column flex=1 min-width=0 gap=2
                text l.text font-size="0.84rem" line-height=1.4
                text l.at class=Mono font-size="0.7rem" color="#808b9c"
