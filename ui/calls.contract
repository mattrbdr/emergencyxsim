// The call queue, as a dispatch console shows it: one dense line per call
// (time, priority, reason, address, means, time left), open calls by priority.
use CallRow from "./model.contract"
use Heading, Empty from "./parts.contract"
use Mono, needColor, outcomeColor from "./theme.contract"
use priorityColor from "./palette.contract"

fn stateCode(s: string): string = s == "nouveau" ? "À QUALIFIER" : s == "attente" ? "À ENGAGER" : s == "engage" ? "ENGAGÉ" : s == "bilan" ? "BILAN" : s == "traitement" ? "EN COURS" : ""
fn stateColor(s: string): string = s == "nouveau" or s == "bilan" ? "#f2555a" : s == "attente" ? "#f0a531" : "#9aa4b2"

component CallQueue
  props
    calls: CallRow[]
    closed: CallRow[]
    selected: string
    pick: action
    firstBuilding: bool
    hint: string
  view
    // A plain native list (UIKit's cells and separators on iOS), on the panel's ground:
    // open calls by priority, then the closed ones under their header.
    list id="calls" appearance="auto" listStyle="plain" flex=1 min-height=0 background-color="transparent" role="tabpanel" aria-label="Appels" testId="panel-appels"
      if calls.length == 0
        section background-color="transparent"
          row padding-top=18 padding-bottom=18 justify-content="center"
            text (firstBuilding ? "Pas d'appel tant qu'aucune caserne n'est en service." : "Aucun appel en cours.") font-size="0.86rem" color="#9aa4b2" text-align="center"
      else
        section background-color="transparent"
          for c, i in calls key=c.id
            CallLine(c=c, active=(c.id == selected), pick=pick(c.id), hinted=(hint == "call" and i == 0), tid=(i == 0 ? "call-first" : `call-${c.id}`))
      if closed.length > 0
        section background-color="transparent"
          header
            text `Clôturés · ${closed.length}`
          for c in closed key=c.id
            row gap=10 align-items="center" background-color="transparent"
              text c.timeText class=Mono font-size="0.72rem" color="#808b9c" width="2.8rem"
              text c.title font-size="0.84rem" flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="#c9d1d9"
              text (c.reward != "" ? c.reward : c.stateLabel) class=Mono font-size="0.72rem" color=outcomeColor(c.outcome)

// One call: a cell with its priority stripe, reason and time left, then state,
// address and the means it needs.
component CallLine
  props
    c: CallRow
    active: bool
    pick: action
    hinted: bool
    tid: string
  view
    row press=pick role="button" aria-label=`Priorité ${c.priority}, ${c.title}, ${c.address}, ${c.stateLabel}, ${c.timeText}` gap=10 align-items="stretch" padding-top=8 padding-bottom=8 background-color=(active ? "#1a212b" : "transparent") box-shadow=(hinted ? "inset 0 0 0 2px #e6edf3" : "none") testId=tid
      view width=4 border-radius=2 background-color=priorityColor(c.priority) flex-shrink=0
      column flex=1 min-width=0 gap=4
        row gap=8 align-items="baseline"
          text `P${c.priority}` class=Mono font-size="0.72rem" font-weight=600 color=priorityColor(c.priority)
          text c.title font-weight=600 font-size="0.9rem" flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          text c.timeText class=Mono font-size="0.78rem" font-weight=600 color=(c.fraction < 0.3 and c.state != "traitement" ? "#f2555a" : "#c9d1d9") testId=`time-${c.id}`
        row gap=8 align-items="baseline"
          text (c.major != "" ? "CRISE" : c.soon ? "DÉBORDE" : stateCode(c.state)) class=Mono font-size="0.62rem" font-weight=600 letter-spacing="0.04em" flex-shrink=0 color=(c.major != "" or c.soon ? "#f2555a" : stateColor(c.state)) animation=(c.soon ? "soon-blink 900ms steps(2) infinite" : "none")
          text c.address class=Mono font-size="0.72rem" color="#9aa4b2" flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          if c.needs.length > 0
            row gap=4 flex-shrink=0
              for n, i in c.needs key=i
                text n.type class=Mono font-size="0.64rem" font-weight=600 color=needColor(n.state)

keyframes soon-blink
  from opacity=1
  to opacity=0.35
