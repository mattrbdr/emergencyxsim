// The call queue, as a dispatch console shows it: one dense line per call
// (time, priority, reason, address, means, time left), open calls by priority.
use CallRow from "./model.contract"
use Heading, Empty from "./parts.contract"
use Mono, needColor, outcomeColor from "./theme.contract"
use priorityColor from "./palette.contract"

fn stateCode(s: string): string = s == "nouveau" ? "À QUALIFIER" : s == "attente" ? "À ENGAGER" : s == "engage" ? "ENGAGÉ" : s == "bilan" ? "BILAN" : s == "traitement" ? "EN COURS" : ""
fn stateColor(s: string): string = s == "nouveau" or s == "bilan" ? "#f2555a" : s == "attente" ? "#f0a531" : "#9aa4b2"

component CallQueue
  props
    calls: CallRow[]
    closed: CallRow[]
    selected: string
    pick: action
    firstBuilding: bool
    hint: string
  view
    column role="tabpanel" id="panel-appels"
      if calls.length == 0
        Empty(icon="phone", text=(firstBuilding ? "Pas d'appel tant qu'aucune caserne n'est en service." : "Aucun appel en cours."))
      for c, i in calls key=c.id
        CallLine(c=c, active=(c.id == selected), pick=pick(c.id), hinted=(hint == "call" and i == 0), tid=(i == 0 ? "call-first" : `call-${c.id}`))
      if closed.length > 0
        view height=14
        Heading(text="Clôturés", detail=`${closed.length}`)
        for c in closed key=c.id
          row gap=8 align-items="baseline" padding="6px 4px" border-bottom="1px solid #1a2029"
            text c.timeText class=Mono font-size="0.7rem" color="#6b7686" width="2.6rem"
            text c.title font-size="0.8rem" flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="#c9d1d9"
            text (c.reward != "" ? c.reward : c.stateLabel) class=Mono font-size="0.7rem" color=outcomeColor(c.outcome)

component CallLine
  props
    c: CallRow
    active: bool
    pick: action
    hinted: bool
    tid: string
  view
    column press=pick role="button" aria-label=`Priorité ${c.priority}, ${c.title}, ${c.address}, ${c.stateLabel}, ${c.timeText}` gap=3 padding="8px 8px 8px 10px" border-left-width=3 border-left-style="solid" border-left-color=priorityColor(c.priority) border-bottom="1px solid #1a2029" background-color=(active ? "#1a212b" : "transparent") box-shadow=(hinted ? "0 0 0 2px #e6edf3" : "none") testId=tid
      row gap=8 align-items="baseline"
        text c.at class=Mono font-size="0.7rem" color="#6b7686" width="2.6rem"
        text `P${c.priority}` class=Mono font-size="0.7rem" font-weight=600 color=priorityColor(c.priority) width="1.4rem"
        text c.title font-weight=600 font-size="0.86rem" flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        text c.timeText class=Mono font-size="0.74rem" font-weight=600 color=(c.fraction < 0.3 and c.state != "traitement" ? "#f2555a" : "#c9d1d9") testId=`time-${c.id}`
      row gap=8 align-items="baseline"
        view width="4.4rem" flex-shrink=0
          text (c.major != "" ? "CRISE" : c.soon ? "DÉBORDE" : stateCode(c.state)) class=Mono font-size="0.6rem" font-weight=600 letter-spacing="0.04em" color=(c.major != "" or c.soon ? "#f2555a" : stateColor(c.state)) animation=(c.soon ? "soon-blink 900ms steps(2) infinite" : "none")
        text c.address class=Mono font-size="0.7rem" color="#9aa4b2" flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        if c.needs.length > 0
          row gap=4 flex-shrink=0
            for n, i in c.needs key=i
              text n.type class=Mono font-size="0.62rem" font-weight=600 color=needColor(n.state)

keyframes soon-blink
  from opacity=1
  to opacity=0.35
