// The strip across the top: town, day and clock, speed, money, level, reputation.
use Snap from "./model.contract"
use Icon from "./icons.contract"
use Figure, Meter from "./parts.contract"
use Mono, Caps, money from "./theme.contract"

component TopBar
  props
    snap: Snap
    wide: bool
    setSpeed: action
    togglePause: action
    openCareer: action
    openContracts: action
  view
    row position="absolute" top=0 left=0 right=0 padding-top="env(safe-area-inset-top)" background-color="#0e1217" border-bottom="1px solid #252c36" testId="bar"
      row flex=1 align-items="center" gap=(wide ? 14 : 8) padding=(wide ? "8px 16px" : "8px 8px") min-width=0
        if wide
          row gap=10 align-items="center" min-width=0
            view width=30 height=30 border-radius=4 background-color="#f2555a" display="flex" align-items="center" justify-content="center" flex-shrink=0
              Icon(name="caserne", size=18, color="#0b0e12")
            column gap=0 min-width=0
              text "EMERGENCY SIM" class=Mono font-size="0.72rem" font-weight=600 letter-spacing="0.14em" white-space="nowrap"
              text snap.city.toUpperCase() class=Caps white-space="nowrap" overflow="hidden" text-overflow="ellipsis" max-width="9rem"
        row gap=8 align-items="baseline"
          if wide
            text snap.date.toUpperCase() class=Caps color="#9aa4b2" white-space="nowrap" testId="date"
          text snap.clock class=Mono font-size=(wide ? "1.5rem" : "1.1rem") font-weight=500 line-height=1 testId="clock"
        // Speed: pause and ×1 ×2 ×4.
        row role="radiogroup" aria-label="Vitesse du temps" appearance="none" border="1px solid #252c36" border-radius=4 overflow="hidden" flex-shrink=0
          button role="radio" aria-checked=snap.paused aria-label=(snap.paused ? "Reprendre" : "Pause") press=togglePause appearance="none" width="2.25rem" height="2rem" display="flex" align-items="center" justify-content="center" background-color=(snap.paused ? "#f0a531" : "transparent") testId="pause"
            Icon(name=(snap.paused ? "play" : "pause"), size=14, color=(snap.paused ? "#0b0e12" : "#e6edf3"))
          if wide
            for s in [1, 2, 4] key=s
              button role="radio" aria-checked=(not snap.paused and snap.speed == s) aria-label=`Vitesse ×${s}` press=setSpeed(s) appearance="none" width="2.25rem" height="2rem" border-left="1px solid #252c36" background-color=(not snap.paused and snap.speed == s ? "#e6edf3" : "transparent") testId=`speed-${s}`
                text `×${s}` class=Mono font-size="0.78rem" font-weight=600 color=(not snap.paused and snap.speed == s ? "#0b0e12" : "#9aa4b2")
          else
            button aria-label=`Vitesse ×${snap.speed}, changer` press=setSpeed(snap.speed == 4 ? 1 : snap.speed * 2) appearance="none" width="2.5rem" height="2rem" border-left="1px solid #252c36" testId="speed-cycle"
              text `×${snap.speed}` class=Mono font-size="0.78rem" font-weight=600
        // The day's weather, and the town event under way or next.
        row gap=6 align-items="center" flex-shrink=0 aria-label=`${snap.weather.label}${snap.weather.event != "" ? `, ${snap.weather.event}` : ""}` testId="weather"
          Icon(name=snap.weather.icon, size=(wide ? 18 : 16), color="#c9d1d9")
          if wide
            text snap.weather.label class=Caps color="#c9d1d9" white-space="nowrap"
          if snap.weather.event != ""
            Icon(name=snap.weather.eventIcon, size=(wide ? 16 : 14), color="#f0a531")
        view flex=1
        if wide
          Figure(icon="money", label=snap.upkeepText, value=snap.moneyText, color=(snap.money < 0 ? "#f2555a" : money()))
        else
          text snap.moneyText class=Mono font-size="0.85rem" font-weight=600 white-space="nowrap" color=(snap.money < 0 ? "#f2555a" : "#e6edf3") testId="money"
        if wide
          Figure(icon="layers", label="Couverture 3 min", value=`${snap.coverage} %`, color=(snap.coverage >= 70 ? "#3fb950" : snap.coverage >= 40 ? "#f0a531" : "#f2555a"))
          Figure(icon="reputation", label="Réputation", value=`${snap.reputation} %`, color="#e6edf3")
        button press=openContracts appearance="none" aria-label=`Contrats du jour : ${snap.contractsDone} sur ${snap.contracts.length}` display="flex" align-items="center" gap=4 padding=(wide ? "5px 8px" : "5px 6px") border="1px solid #252c36" border-radius=4 flex-shrink=0 testId="open-contracts"
          Icon(name="flag", size=15, color=(snap.contractsDone == snap.contracts.length and snap.contracts.length > 0 ? "#3fb950" : "#e6edf3"))
          text `${snap.contractsDone}/${snap.contracts.length}` class=Mono font-size="0.8rem" font-weight=600
        // Level: a badge and the XP bar; opens the career panel.
        button press=openCareer appearance="none" aria-label=`${snap.rank}, niveau ${snap.level}, ${snap.xpText}` display="flex" align-items="center" gap=8 padding=(wide ? "4px 6px" : "0") border-radius=4 flex-shrink=0 testId="level"
          if wide
            Icon(name=snap.rankIcon, size=18, color="#f0a531")
          view width="2rem" height="2rem" border="1px solid #4b5668" border-radius=4 display="flex" align-items="center" justify-content="center"
            text `${snap.level}` class=Mono font-weight=600 color="#e6edf3"
          if wide
            column gap=4 width="7rem"
              text snap.xpText class=Caps color="#9aa4b2"
              Meter(fraction=snap.levelProgress, color="#9aa4b2")
