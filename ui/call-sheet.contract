// The call sheet: what the caller says, the qualification, what the scene needs,
// who is engaged, and the vehicles to send.
use CallRow, Option, Preset, Ack, Decision from "./model.contract"
use Icon from "./icons.contract"
use Tag, CallSign, Heading from "./parts.contract"
use Mono, Caps, Primary, Secondary, Quiet, familyColor, familyIcon, needColor, callStateColor, plural, money from "./theme.contract"
use priorityColor, serviceColor from "./palette.contract"

component CallSheet
  props
    c: CallRow
    seq: number
    close: action
    pickUnit: action
    hint: string
  state picks: string[] = []
  state showAll = false
  resource opts = dispatchOptions(c.id, seq) as shape Option[] else empty() transient
  resource pre = dispatchPresets(c.id, seq) as shape Preset[] else empty() transient
  mutation ordered as shape Ack queue
  derive suggested = opts.filter(o => o.suggested).map(o => o.id)
  derive shown = opts.filter(o => showAll or o.needed or picks.includes(o.id)).slice(0, 14)
  derive open = c.state != "traitement" and c.state != "clos"

  action qualify(family: string)
    send ordered = qualifyCall(c.id, family)
    haptic("selection")
  action toggle(id: string)
    picks = picks.includes(id) ? picks.filter(x => x != id) : picks.concat([id])
  action sendPreset(ids: string[])
    send ordered = send(c.id, ids)
    picks = []
    haptic("success")
  action engage
    send ordered = send(c.id, picks.isEmpty() ? suggested : picks)
    picks = []
    haptic("success")
  action recall(id: string)
    send ordered = recallUnit(id)
  action toggleAll
    showAll = not showAll
  action choose(id: string)
    send ordered = decide(c.id, id)
    haptic("selection")

  view
    column gap=16 testId="sheet"
      // Header.
      row align-items="flex-start" gap=10
        column flex=1 min-width=0 gap=6
          row gap=8 align-items="center"
            text `P${c.priority}` class=Mono font-size="0.72rem" font-weight=600 padding="2px 7px" border-radius=3 background-color=priorityColor(c.priority) color="#0b0e12"
            Icon(name=familyIcon(c.family), size=15, color=familyColor(c.family))
            text c.familyLabel.toUpperCase() class=Caps color=familyColor(c.family)
          if c.major != ""
            text c.major class=Mono font-size="0.66rem" font-weight=600 letter-spacing="0.06em" color="#f2555a" testId="sheet-major"
          text c.title font-size="1.3rem" font-weight=600 line-height=1.2 role="heading" aria-level=2 testId="sheet-title"
          text c.address class=Mono font-size="0.78rem" color="#9aa4b2"
        button press=close aria-label="Fermer la fiche" class=Quiet testId="sheet-close"
          Icon(name="close", size=18, color="#9aa4b2")

      if c.decision.pending
        DecisionCard(d=c.decision, choose=choose)

      row gap=8 align-items="center" padding="8px 0" border-top="1px solid #252c36" border-bottom="1px solid #252c36"
        text c.stateLabel.toUpperCase() class=Mono font-size="0.7rem" font-weight=600 letter-spacing="0.04em" color=callStateColor(c.state)
        view flex=1
        Icon(name="clock", size=14, color="#9aa4b2")
        text c.timeText class=Mono font-weight=600 color=(c.fraction < 0.3 and c.state != "traitement" ? "#f2555a" : "#e6edf3")
        if c.reward != ""
          Icon(name="money", size=14, color=money())
          text c.reward class=Mono font-size="0.82rem" color=money()
      if c.risk != ""
        row gap=6 align-items="center"
          Icon(name="alert", size=13, color="#f0a531")
          text c.risk class=Mono font-size="0.75rem" color="#f0a531"

      // The caller, as a transcript line.
      column gap=6 padding="12px 14px" background-color="#0b0e12" border-left-width=2 border-left-style="solid" border-left-color=priorityColor(c.priority)
        row gap=6 align-items="center"
          Icon(name="phone", size=12, color="#6b7686")
          text `APPELANT · ${c.at}` class=Caps
        text `« ${c.caller} »` font-size="0.95rem" line-height=1.5 testId="caller"

      if not c.qualified
        column gap=8 padding=(hint == "call" ? 8 : 0) box-shadow=(hint == "call" ? "0 0 0 2px #e6edf3" : "none") border-radius=4 testId="qualify"
          Heading(text="Qualifier l'appel", detail="")
          column gap=6
            for f in ["sap", "feu", "route", "police", "technique"] key=f
              button press=qualify(f) class=Secondary justify-content="flex-start" border-left-width=3 border-left-style="solid" border-left-color=familyColor(f) testId=`q-${f}`
                Icon(name=familyIcon(f), size=16, color=familyColor(f))
                text (f == "sap" ? "Secours à personne" : f == "feu" ? "Incendie" : f == "route" ? "Accident" : f == "police" ? "Police" : "Opération diverse") font-weight=500
      else
        column gap=8
          Heading(text="Moyens nécessaires", detail="")
          row gap=6 flex-wrap="wrap"
            for n, i in c.needs key=i
              row gap=6 align-items="center" padding="5px 8px" border-radius=3 background-color="#171c24" border-width=1 border-style="solid" border-color=needColor(n.state) aria-label=`${n.label} : ${n.state == "surplace" ? "sur place" : n.state == "engage" ? "engagé" : "manquant"}`
                Icon(name=(n.state == "surplace" ? "check" : n.state == "engage" ? "flag" : "alert"), size=12, color=needColor(n.state))
                text n.type class=Mono font-size="0.75rem" font-weight=600 color=needColor(n.state)

        if c.units.length > 0
          column gap=4
            Heading(text="Engagés", detail=`${c.units.length}`)
            for u in c.units key=u.id
              row gap=10 align-items="center" padding="7px 10px" border-bottom="1px solid #1f2630"
                view width=6 height=6 background-color=serviceColor(u.service)
                button press=pickUnit(u.id) appearance="none" flex=1 text-align="left"
                  text u.name class=Mono font-size="0.82rem" font-weight=600
                text (u.eta != "" ? `${u.status} · ${u.eta}` : u.status) class=Mono font-size="0.72rem" color="#9aa4b2"
                if u.eta != ""
                  button press=recall(u.id) aria-label=`Désengager ${u.name}` class=Quiet padding=4 testId=`recall-${u.id}`
                    Icon(name="close", size=12, color="#6b7686")

        if open
          column gap=6 testId="dispatch"
            row align-items="center" gap=8
              Heading(text="Moyens disponibles", detail=`${plural(opts.length, "véhicule", "véhicules")}`)
            if shown.length == 0
              text (opts.length == 0 ? "Aucun véhicule libre. Achetez-en dans une caserne." : "Aucun véhicule du type demandé n'est libre.") font-size="0.85rem" color="#9aa4b2"
            for o in shown key=o.id
              row press=toggle(o.id) role="checkbox" aria-checked=picks.includes(o.id) aria-label=`${o.name}, ${o.long}, arrivée ${o.eta}` gap=10 align-items="center" padding="7px 10px" border-radius=4 background-color=(picks.includes(o.id) ? "#1f2630" : "#171c24") border-width=1 border-style="solid" border-color=(picks.includes(o.id) ? "#e6edf3" : "#1f2630") opacity=(o.needed ? 1 : 0.6) testId=`opt-${o.id}`
                view width=16 height=16 border-radius=2 border-width=1 border-style="solid" border-color=(picks.includes(o.id) ? "#e6edf3" : "#4b5668") background-color=(picks.includes(o.id) ? "#e6edf3" : "transparent") display="flex" align-items="center" justify-content="center" flex-shrink=0
                  if picks.includes(o.id)
                    Icon(name="check", size=12, color="#0b0e12")
                CallSign(label=o.type, service=o.service, color=serviceColor(o.service))
                column flex=1 min-width=0
                  row gap=6 align-items="center"
                    text o.name class=Mono font-size="0.82rem" font-weight=600
                    if o.suggested
                      text "RÉFLEXE" class=Caps font-size="0.58rem" color="#9aa4b2"
                    if o.tired
                      text "FATIGUÉ" class=Caps font-size="0.58rem" color="#f0a531"
                  text (o.returning ? `${o.station} · en retour` : o.station) font-size="0.72rem" color="#6b7686" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
                text o.eta class=Mono font-size="0.8rem" font-weight=600
            if opts.filter(o => not o.needed).length > 0
              button press=toggleAll class=Quiet testId="toggle-all"
                text (showAll ? "Masquer les autres véhicules" : `Voir tous les véhicules (${opts.length})`) font-size="0.8rem"
            // Ready-made departures, or the vehicles picked by hand.
            if picks.isEmpty()
              column gap=6 testId="presets"
                for p in pre key=p.id
                  button press=sendPreset(p.units) class=(p.id == "rapide" ? Primary : Secondary) justify-content="flex-start" padding="9px 12px" box-shadow=(hint == "engage" and p.id == "rapide" ? "0 0 0 2px #e6edf3" : "none") testId=(p.id == "rapide" ? "engage" : `preset-${p.id}`)
                    column align-items="flex-start" gap=3 flex=1 min-width=0
                      row gap=8 align-items="center" width="100%"
                        Icon(name=(p.id == "rapide" ? "flag" : p.id == "couverture" ? "layers" : "reputation"), size=15, color=(p.id == "rapide" ? "#0b0e12" : "#e6edf3"))
                        text p.label font-weight=600 flex=1 text-align="left" color=(p.id == "rapide" ? "#0b0e12" : "#e6edf3")
                        text p.eta class=Mono font-size="0.78rem" font-weight=600 color=(p.id == "rapide" ? "#0b0e12" : "#e6edf3")
                      text p.names class=Mono font-size="0.7rem" color=(p.id == "rapide" ? "#30394a" : "#9aa4b2") text-align="left"
                      text p.cost font-size="0.72rem" text-align="left" color=(p.costly ? (p.id == "rapide" ? "#b3261e" : "#f2555a") : (p.id == "rapide" ? "#30394a" : "#6b7686"))
            else
              button press=engage class=Primary box-shadow=(hint == "engage" ? "0 0 0 2px #e6edf3" : "none") testId="engage"
                Icon(name="flag", size=16, color="#0b0e12")
                text `Engager ${plural(picks.length, "véhicule", "véhicules")}` font-weight=600

// The crew chief's report: the situation changed, the room decides.
component DecisionCard
  props
    d: Decision
    choose: action
  view
    column gap=10 padding=14 background-color="#1a1610" border="1px solid #f0a531" border-radius=4 testId="decision"
      row gap=8 align-items="center"
        Icon(name="alert", size=16, color="#f0a531")
        text `BILAN · ${d.from.toUpperCase()}` class=Caps color="#f0a531" flex=1
        text d.left class=Mono font-size="0.72rem" color="#f0a531"
      text d.report font-size="0.95rem" line-height=1.45 testId="decision-report"
      column gap=6
        for ch in d.choices key=ch.id
          button press=choose(ch.id) disabled=(not ch.enabled) class=(ch.id == "renfort" ? Primary : Secondary) justify-content="flex-start" opacity=(ch.enabled ? 1 : 0.45) testId=`decide-${ch.id}`
            column align-items="flex-start" gap=2 flex=1
              text ch.label font-weight=600 color=(ch.id == "renfort" ? "#0b0e12" : "#e6edf3")
              text ch.detail class=Mono font-size="0.68rem" color=(ch.id == "renfort" ? "#30394a" : "#9aa4b2") text-align="left"
