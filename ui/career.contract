// Progress: the card a new level shows, and the career panel (stats, settings).
use Unlock, Stats, ShopItem, AchievementRow, RoadmapStep, Settings from "./model.contract"
use Icon from "./icons.contract"
use CallSign, Heading, Meter from "./parts.contract"
use Mono, Caps, Primary, Secondary, Quiet, money from "./theme.contract"
use serviceColor from "./palette.contract"

component UnlockCard
  props
    unlock: Unlock
    done: action
  view
    column position="absolute" inset=0 align-items="center" justify-content="center" padding=20 background-color="rgba(6,8,11,0.78)" testId="unlock"
      column max-width="28rem" width="100%" box-sizing="border-box" gap=16 padding=22 background-color="#11151b" border="1px solid #e6edf3" border-radius=6 animation="rise 360ms cubic-bezier(0.2, 0.8, 0.2, 1)"
        row gap=12 align-items="center"
          view width="3.25rem" height="3.25rem" border="1px solid #e6edf3" border-radius=4 display="flex" align-items="center" justify-content="center"
            text `${unlock.level}` class=Mono font-size="1.5rem" font-weight=600 color="#e6edf3"
          column gap=2
            text "NIVEAU ATTEINT" class=Caps color="#e6edf3"
            text (unlock.level == 1 ? "Prise de poste" : unlock.vehicles.length + unlock.buildings.length + unlock.upgrades.length > 0 ? "Nouveaux moyens disponibles" : "Nouvelles missions") font-size="1.2rem" font-weight=600 role="heading" aria-level=2
        if unlock.promoted
          row gap=12 align-items="center" padding="10px 12px" background-color="#1a212b" border-left-width=3 border-left-style="solid" border-left-color="#f0a531" testId="promotion"
            Icon(name=unlock.rankIcon, size=30, color="#f0a531")
            column gap=2
              text "PROMOTION" class=Caps color="#f0a531"
              text unlock.rank font-size="1.1rem" font-weight=600
        if unlock.buildings.length > 0
          column gap=6
            Heading(text="Bâtiment", detail="")
            for b in unlock.buildings key=b
              row gap=8 align-items="center"
                Icon(name="build", size=16, color="#e6edf3")
                text b font-weight=500
        if unlock.vehicles.length > 0
          column gap=6
            Heading(text="Véhicule", detail="")
            for v in unlock.vehicles key=v.type
              row gap=10 align-items="center"
                CallSign(label=v.label, service=v.service, color=serviceColor(v.service))
                column flex=1
                  text v.long font-size="0.85rem" font-weight=500
                  text `${v.price} · entretien ${v.upkeep}` class=Mono font-size="0.68rem" color="#9aa4b2"
        if unlock.calls.length > 0
          column gap=6
            Heading(text="Interventions", detail=`${unlock.calls.length}`)
            text unlock.calls.join(" · ") font-size="0.85rem" color="#9aa4b2" line-height=1.5
        if unlock.upgrades.length > 0
          column gap=6
            Heading(text="Amélioration de bâtiment", detail="")
            for t in unlock.upgrades key=t
              row gap=8 align-items="center"
                Icon(name="build", size=16, color="#e6edf3")
                text t font-weight=500
        if unlock.majors.length > 0
          column gap=6
            Heading(text="Intervention exceptionnelle", detail="")
            for t in unlock.majors key=t
              row gap=8 align-items="center"
                view width=8 height=8 background-color="#f2555a"
                text t font-weight=500
        if unlock.vehicles.length > 0
          text "Achetez le véhicule dans un bâtiment pour recevoir ces appels." font-size="0.78rem" color="#808b9c"
        button press=done class=Primary testId="unlock-ok"
          text "Continuer" font-weight=600

// The career view: grade and level, then the record, the achievements and the
// road ahead (what each level brings).
component CareerView
  props
    level: number
    maxLevel: number
    xpText: string
    progress: number
    reputation: number
    coverage: number
    repEffect: string
    difficulty: string
    stats: Stats
    city: string
    rank: string
    rankIcon: string
    achievements: AchievementRow[]
    achievementsDone: number
    wide: bool
    settings: Settings
    setSetting: action
    reset: action
  state section = "bilan"
  state onlyTodo = false
  resource steps = roadmap() as shape RoadmapStep[] else empty() transient
  action pick(s: string)
    section = s
  action toggleTodo
    onlyTodo = not onlyTodo
  view
    column gap=16 max-width="56rem" width="100%" margin="0 auto" testId="career"
      row gap=14 align-items="center" flex-wrap="wrap"
        view width="3.5rem" height="3.5rem" border="1px solid #f0a531" border-radius=4 display="flex" align-items="center" justify-content="center" flex-shrink=0
          Icon(name=rankIcon, size=30, color="#f0a531")
        column gap=6 flex="1 1 14rem" min-width=0
          row align-items="baseline" gap=8
            text rank font-size="1.25rem" font-weight=600 flex=1 role="heading" aria-level=2 testId="rank"
            text `Niveau ${level} / ${maxLevel}` class=Mono font-size="0.78rem" color="#9aa4b2"
          Meter(fraction=progress, color="#e6edf3")
          text `${xpText} · garde ${difficulty.toLowerCase()}` class=Mono font-size="0.7rem" color="#808b9c"
        row gap=8 flex="1 1 14rem"
          Cell(label=`Réputation · ${repEffect}`, value=`${reputation} %`, color="#e6edf3")
          Cell(label="Couverture 3 min", value=`${coverage} %`, color=(coverage >= 70 ? "#3fb950" : coverage >= 40 ? "#f0a531" : "#f2555a"))
      // A segmented control: UIKit's on iOS.
      row role="tablist" aria-label="Carrière"
        for t in ["bilan", "succes", "progression", "reglages"] key=t
          button role="tab" aria-selected=(section == t) press=pick(t) testId=`career-${t}`
            text (t == "bilan" ? "Bilan" : t == "succes" ? `Succès ${achievementsDone}` : t == "progression" ? "Progression" : "Réglages")
      if section == "reglages"
        column gap=8 testId="settings"
          Toggle(label="Son", detail="Sonneries, radio, alarmes et gains.", on=settings.sound, flip=setSetting("sound", not settings.sound), tid="setting-sound")
          Toggle(label="Sirènes au départ", detail="Le deux-tons quand un véhicule part.", on=settings.sirens, flip=setSetting("sirens", not settings.sirens), tid="setting-sirens")
          Toggle(label="Animations", detail="Ondes, gyrophares, tampons. Désactivées, les informations restent affichées.", on=settings.motion, flip=setSetting("motion", not settings.motion), tid="setting-motion")
      if section == "bilan"
        CareerStats(stats=stats, reputation=reputation, city=city, reset=reset)
      if section == "succes"
        column gap=8
          button press=toggleTodo role="switch" aria-checked=onlyTodo appearance="none" align-self="flex-start" display="flex" align-items="center" gap=8 padding="4px 0" testId="achievements-todo"
            view width=14 height=14 border="1px solid #4b5668" border-radius=2 background-color=(onlyTodo ? "#e6edf3" : "transparent")
            text "Seulement ceux à obtenir" font-size="0.8rem" color="#9aa4b2"
          column display="grid" grid-template-columns=(wide ? "1fr 1fr" : "1fr") gap=6 testId="achievements"
            for a in achievements.filter(x => not onlyTodo or not x.done) key=a.id
              AchievementLine(a=a)
      if section == "progression"
        column gap=0 testId="roadmap"
          for s in steps key=s.level
            row gap=12 align-items="stretch" testId=`step-${s.level}`
              column width="2.5rem" align-items="center" flex-shrink=0
                view width="2rem" height="2rem" border-radius=4 border-width=1 border-style="solid" border-color=(s.level == level ? "#e6edf3" : s.level < level ? "#4b5668" : "#252c36") background-color=(s.level == level ? "#e6edf3" : "transparent") display="flex" align-items="center" justify-content="center"
                  text `${s.level}` class=Mono font-size="0.8rem" font-weight=600 color=(s.level == level ? "#0b0e12" : s.level < level ? "#9aa4b2" : "#808b9c")
                view flex=1 width=1 background-color="#252c36"
              column flex=1 min-width=0 gap=4 padding-bottom=14 opacity=(s.level > level ? 0.75 : 1)
                if s.promoted
                  row gap=6 align-items="center"
                    Icon(name=s.rankIcon, size=14, color="#f0a531")
                    text s.rank.toUpperCase() class=Caps color="#f0a531"
                for it in s.items key=it
                  text it font-size="0.82rem" color=(s.level <= level ? "#e6edf3" : "#c9d1d9")
                for m in s.majors key=m
                  row gap=6 align-items="center"
                    view width=7 height=7 background-color="#f2555a"
                    text `Crise · ${m}` font-size="0.8rem" color="#f2555a"
                if s.calls > 0
                  text `${s.calls} nouveau${s.calls > 1 ? "x" : ""} type${s.calls > 1 ? "s" : ""} d'appel` class=Mono font-size="0.68rem" color="#808b9c"

component AchievementLine
  props
    a: AchievementRow
  view
    row gap=10 align-items="center" padding="8px 10px" background-color="#171c24" border-radius=4 opacity=(a.done ? 1 : 0.75) testId=`achievement-${a.id}`
      view width="1.6rem" height="1.6rem" border-radius=4 border-width=1 border-style="solid" border-color=(a.done ? "#f0a531" : "#30394a") display="flex" align-items="center" justify-content="center" flex-shrink=0
        Icon(name=(a.done ? "check" : "lock"), size=13, color=(a.done ? "#f0a531" : "#808b9c"))
      column flex=1 min-width=0 gap=3
        text a.title font-size="0.84rem" font-weight=600 color=(a.done ? "#e6edf3" : "#c9d1d9")
        text a.detail font-size="0.72rem" color="#9aa4b2" line-height=1.35
        if not a.done and a.fraction > 0
          Meter(fraction=a.fraction, color="#9aa4b2")
      column align-items="flex-end" gap=2 flex-shrink=0
        text a.progressText class=Mono font-size="0.66rem" color=(a.done ? "#f0a531" : "#9aa4b2")
        text a.reward class=Mono font-size="0.62rem" color="#808b9c"

component CareerStats
  props
    stats: Stats
    reputation: number
    city: string
    reset: action
  view
    column gap=14
      row flex-wrap="wrap" gap=8
        Cell(label="Appels", value=`${stats.calls}`, color="#e6edf3")
        Cell(label="Victimes sauvées", value=`${stats.saved}`, color="#3fb950")
        Cell(label="Victimes perdues", value=`${stats.lost}`, color="#f2555a")
        Cell(label="Échecs", value=`${stats.failed}`, color="#e6edf3")
        Cell(label="Délai moyen", value=stats.avgResponse, color="#e6edf3")
        Cell(label="Qualification juste", value=`${stats.accuracy} %`, color="#e6edf3")
        Cell(label="Recettes", value=stats.earned, color=money())
        Cell(label="Dépenses", value=stats.spent, color="#9aa4b2")
      text `Ville : ${city}` class=Caps
      button press=reset class=Secondary testId="new-career"
        Icon(name="city", size=14, color="#f2555a")
        text "Nouvelle carrière (autre ville)" color="#f2555a"

component Cell
  props
    label: string
    value: string
    color: string
  view
    column flex="1 1 7.5rem" gap=2 padding="8px 10px" background-color="#171c24" border-radius=4
      text value class=Mono font-size="1rem" font-weight=600 color=color white-space="nowrap"
      text label class=Caps font-size="0.6rem"

keyframes rise
  from opacity=0 translate="0px 12px"

component Toggle
  props
    label: string
    detail: string
    on: bool
    flip: action
    tid: string
  action changed(checked: bool)
    flip()
  view
    row gap=12 align-items="center" padding="10px 12px" background-color="#171c24" border-radius=4
      column flex=1 min-width=0 gap=2
        text label font-weight=600 font-size="0.88rem"
        text detail font-size="0.74rem" color="#9aa4b2" line-height=1.35
      // UIKit's UISwitch on iOS, the platform's switch elsewhere.
      input type="checkbox" switch checked=on change=changed aria-label=label accent-color="#3fb950" margin=0 flex-shrink=0 testId=tid
