// The shapes app.ts answers with (src/snapshot.ts builds them). Shared by every screen.

shape Ack
  seq: number
  cam: number
  picked: string

shape Boot
  ready: bool
  city: string

shape Match
  insee: string
  name: string
  department: string
  population: number

shape CityStatus
  phase: string
  message: string
  busy: bool
  matches: Match[]

shape Need
  type: string
  label: string
  service: string
  state: string

shape Engaged
  id: string
  name: string
  service: string
  status: string
  eta: string

shape Choice
  id: string
  label: string
  detail: string
  enabled: bool

shape Decision
  pending: bool
  from: string
  report: string
  left: string
  choices: Choice[]

shape CallRow
  id: string
  title: string
  family: string
  familyLabel: string
  priority: number
  address: string
  caller: string
  state: string
  stateLabel: string
  outcome: string
  qualified: bool
  escalated: bool
  at: string
  timeText: string
  fraction: number
  reward: string
  risk: string
  major: string
  decision: Decision
  needs: Need[]
  units: Engaged[]

shape UnitRow
  id: string
  name: string
  type: string
  long: string
  service: string
  status: string
  statusCode: number
  statusLabel: string
  building: string
  buildingName: string
  callTitle: string
  eta: string
  missions: number
  canSell: bool
  resale: string
  fatigue: number
  wear: number
  tired: bool
  canRest: bool
  canService: bool
  servicePrice: string
  waitText: string

shape BuildingRow
  id: string
  name: string
  kind: string
  label: string
  service: string
  slots: number
  used: number
  maxSlots: number
  home: number
  canExpand: bool
  expandPrice: string
  upkeep: string
  patients: number

shape SiteRow
  index: number
  name: string
  kind: string
  label: string
  service: string
  price: string
  open: bool
  level: number

shape BuildOption
  kind: string
  label: string
  service: string
  price: string
  buyPrice: string
  open: bool
  level: number

shape ShopItem
  type: string
  label: string
  long: string
  service: string
  price: string
  upkeep: string
  level: number
  why: string
  owned: number

shape Unlock
  level: number
  vehicles: ShopItem[]
  buildings: string[]
  calls: string[]
  majors: string[]
  upgrades: string[]
  promoted: bool
  rank: string
  rankIcon: string

shape UpgradeRow
  id: string
  label: string
  detail: string
  price: string
  upkeep: string
  why: string
  owned: bool

shape LogLine
  id: number
  at: string
  text: string
  tone: string

shape Stats
  calls: number
  saved: number
  lost: number
  failed: number
  avgResponse: string
  accuracy: number
  earned: string
  spent: string

shape ContractRow
  id: string
  label: string
  progressText: string
  fraction: number
  reward: string
  xp: number
  state: string

shape Guide
  kind: string
  title: string
  text: string
  hint: string
  index: number
  total: number

shape Crisis
  active: bool
  title: string
  phaseTitle: string
  index: number
  total: number
  callId: string
  injured: number

shape CrisisReport
  show: bool
  title: string
  success: bool
  injured: number
  earned: string
  minutes: number

shape Weather
  label: string
  icon: string
  bulletin: string
  event: string
  eventIcon: string

shape AchievementRow
  id: string
  title: string
  detail: string
  done: bool
  fraction: number
  progressText: string
  reward: string

shape Snap
  seq: number
  city: string
  attribution: string
  day: number
  date: string
  weather: Weather
  rank: string
  rankIcon: string
  achievements: AchievementRow[]
  achievementsDone: number
  clock: string
  speed: number
  paused: bool
  money: number
  moneyText: string
  upkeepText: string
  level: number
  maxLevel: number
  xp: number
  xpText: string
  levelProgress: number
  reputation: number
  unlock: Unlock
  showUnlock: bool
  newCalls: number
  placing: string
  aimed: bool
  aimText: string
  placingPrice: string
  overlay: bool
  coverage: number
  firstBuilding: bool
  calls: CallRow[]
  closed: CallRow[]
  units: UnitRow[]
  free: number
  buildings: BuildingRow[]
  sites: SiteRow[]
  build: BuildOption[]
  log: LogLine[]
  toast: LogLine
  stats: Stats
  guide: Guide
  crisis: Crisis
  report: CrisisReport
  contracts: ContractRow[]
  contractsDone: number
  streak: number

shape Option
  id: string
  name: string
  type: string
  long: string
  service: string
  station: string
  eta: string
  suggested: bool
  needed: bool
  returning: bool
  tired: bool
