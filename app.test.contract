seed 3

test "first launch asks for a town; the demo town starts a career"
  expect tree has "city-picker"
  tap "city-demo"
  clock data
  expect tree missing "city-picker"
  expect state snap.money == 30000
  expect state snap.level == 1
  expect tree has "build-menu"

test "the first caserne is free and comes with a VSAV"
  tap "city-demo"
  clock data
  clock +500
  tap "build-caserne"
  clock data
  clock +300
  tap "map"
  clock data
  clock +300
  tap "placing-confirm"
  clock data
  clock +300
  expect state snap.buildings.length == 1
  expect state snap.money == 30000
  expect state snap.units.0 .type == "VSAV"
  expect tree has "building-sheet"
  expect tree has "buy-VSAV"
  expect tree missing "buy-FPT"

test "a call is qualified, dispatched and paid"
  tap "city-demo"
  clock data
  clock +500
  tap "build-caserne"
  clock data
  clock +300
  tap "map"
  clock data
  clock +300
  tap "placing-confirm"
  clock data
  clock +300
  tap "building-close"
  clock +5000
  clock data
  expect state snap.calls.length == 1
  tap "call-first"
  clock data
  clock +300
  tap "q-sap"
  clock data
  clock +300
  expect text "sheet-title" == "Malaise à domicile"
  tap "engage"
  clock data
  clock +300
  expect state snap.free == 0
  tap "speed-cycle"
  clock data
  tap "speed-cycle"
  clock data
  expect state snap.speed == 4
  clock +20000
  clock data
  expect state snap.stats.saved == 1
  expect state snap.money >= 30001

test "the career survives a reload"
  tap "city-demo"
  clock data
  clock +500
  tap "build-caserne"
  clock data
  clock +300
  tap "map"
  clock data
  clock +300
  tap "placing-confirm"
  clock data
  clock +300
  tap "buy-VSAV"
  clock data
  clock +300
  expect state snap.units.length == 2
  reload
  clock data
  clock +300
  clock data
  expect tree missing "city-picker"
  expect state snap.units.length == 2
  expect state snap.money == 12000
