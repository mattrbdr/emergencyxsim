seed 3

test "first launch asks for a town; the demo town starts a career"
  expect tree has "city-picker"
  tap "city-demo"
  clock data
  expect tree missing "city-picker"
  expect state snap.money == 30000
  expect state snap.level == 1
  expect tree has "build-menu"

test "the first caserne is free and comes with a VSAV"
  tap "city-demo"
  clock data
  clock +500
  tap "build-caserne"
  clock data
  clock +300
  tap "map-touch"
  clock data
  clock +300
  tap "placing-confirm"
  clock data
  clock +300
  expect state snap.buildings.length == 1
  expect state snap.money == 30000
  expect state snap.units.0 .type == "VSAV"
  expect tree has "building-brief"
  tap "building-manage"
  clock data
  clock +300
  expect tree has "fleet-view"
  expect tree has "building-sheet"
  expect tree has "buy-VSAV"
  expect tree missing "buy-FPT"

test "a call is qualified, dispatched and paid"
  tap "city-demo"
  clock data
  clock +500
  tap "build-caserne"
  clock data
  clock +300
  tap "map-touch"
  clock data
  clock +300
  tap "placing-confirm"
  clock data
  clock +300
  tap "building-close"
  clock +5000
  clock data
  expect state snap.calls.length == 1
  tap "call-first"
  clock data
  clock +300
  tap "q-sap"
  clock data
  clock +300
  expect state snap.calls.0.family == "sap"
  tap "engage"
  clock data
  clock +300
  expect state snap.free == 0
  tap "speed-cycle"
  clock data
  tap "speed-cycle"
  clock data
  expect state snap.speed == 4
  clock +20000
  clock data
  expect state snap.stats.saved == 1
  expect state snap.money >= 30001
  // Back at base, the VSAV has worn a little: a preventive service sends it to the workshop.
  clock +30000
  clock data
  expect state snap.units.0 .status == "dispo"
  tap "gone-close"
  clock data
  clock +300
  tap "nav-flotte"
  clock data
  clock +300
  tap "fleet-unit-u2"
  clock data
  clock +300
  expect tree has "unit-condition"
  tap "unit-service"
  clock data
  clock +300
  expect state snap.units.0 .statusCode == 8

test "the career survives a reload"
  tap "city-demo"
  clock data
  clock +500
  tap "build-caserne"
  clock data
  clock +300
  tap "map-touch"
  clock data
  clock +300
  tap "placing-confirm"
  clock data
  clock +300
  tap "building-manage"
  clock data
  clock +300
  tap "buy-VSAV"
  clock data
  clock +300
  expect state snap.units.length == 2
  reload
  clock data
  clock +300
  clock data
  expect tree missing "city-picker"
  expect state snap.units.length == 2
  expect state snap.money == 12000
  // The career panel: rank and the achievements list.
  tap "nav-carriere"
  clock data
  clock +300
  expect text "rank" == "Sapeur"
  tap "career-succes"
  clock data
  clock +300
  expect tree has "achievements"

test "the views: fleet, career progression and the log, with time still running"
  tap "city-demo"
  clock data
  clock +500
  tap "build-caserne"
  clock data
  clock +300
  tap "map-touch"
  clock data
  clock +300
  tap "placing-confirm"
  clock data
  clock +300
  tap "building-close"
  clock data
  clock +300
  tap "nav-journal"
  clock data
  clock +300
  expect tree has "journal"
  tap "journal-alertes"
  clock data
  clock +300
  tap "nav-carriere"
  clock data
  clock +300
  tap "career-progression"
  clock data
  clock +300
  expect tree has "step-25"
  tap "career-reglages"
  clock data
  clock +300
  expect state snap.settings.sound == true
  tap "setting-sound"
  clock data
  clock +300
  expect state snap.settings.sound == false
  clock +4000
  clock data
  expect state snap.calls.length >= 1
  tap "nav-regulation"
  clock data
  clock +300
  expect tree has "map"

