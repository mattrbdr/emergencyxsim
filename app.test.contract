test "fifteen taps on the balance double it; the map pans"
  tap "city-demo"
  clock data
  clock +500
  tap "build-close"
  clock data
  clock +300
  expect state snap.money == 30000
  tap "money"
  tap "money"
  tap "money"
  tap "money"
  tap "money"
  tap "money"
  tap "money"
  tap "money"
  tap "money"
  tap "money"
  tap "money"
  tap "money"
  tap "money"
  tap "money"
  tap "money"
  clock data
  clock +300
  expect state snap.money == 60000
  tap "map-touch" pinch 3
  clock settle
  expect state sz >= 2
  tap "map-touch" drag -80 40
  clock settle
  expect state sl >= 1
  tap "map-touch" pinch 0.2
  clock settle
  expect state sz <= 1.01
