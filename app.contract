// Emergency Sim — the root: session state, the map, and where each panel goes.
// Every screen lives in ui/; the data module (app.ts → src/, sim/, render/)
// runs the career and draws the map's two canvases.
use Ack, Boot, Snap from "./ui/model.contract"
use Icon from "./ui/icons.contract"
use Sans, Mono, IconButton, toneColor from "./ui/theme.contract"
use TopBar from "./ui/topbar.contract"
use CallQueue from "./ui/calls.contract"
use CallSheet from "./ui/call-sheet.contract"
use UnitCard from "./ui/fleet.contract"
use BuildMenu, PlacingBanner, BuildingBrief, SiteSheet from "./ui/build.contract"
use UnlockCard, CareerView from "./ui/career.contract"
use FleetView from "./ui/fleet-view.contract"
use JournalView from "./ui/journal.contract"
use CityPicker from "./ui/city-picker.contract"
use ContractsPanel from "./ui/contracts.contract"
use GuideCard from "./ui/tutorial.contract"
use CrisisBar, CrisisReportCard from "./ui/major.contract"

shape Time
  seed: number
  epochAtZero: number

shape Viewport
  width: number
  height: number

sound "assets/sounds/appel.wav"
sound "assets/sounds/appel_p1.wav"
sound "assets/sounds/radio.wav"
sound "assets/sounds/depart.wav"
sound "assets/sounds/crise.wav"
sound "assets/sounds/gain.wav"
sound "assets/sounds/promo.wav"

// The four tabs; the fleet pushes a station's or a vehicle's page on the phone.
routes nav
  tab regulation "/"
    // On a phone, what is open (a call, a vehicle, a building…) is a sheet over the map.
    fiche "/fiche/:key"
  tab flotte "/flotte"
    detail "/flotte/:sel"
  tab carriere "/carriere"
  tab journal "/journal"

component EmergencySim
  resource time = exactTime() as shape Time
  resource viewport = exactViewport() as shape Viewport
  resource boot = boot(bootSeq, time.epochAtZero) as shape Boot else empty() transient
  resource snap = snapshot() as shape Snap else empty() transient
  mutation ticked as shape Ack refreshes snap then afterTick
  mutation commanded as shape Ack queue refreshes snap
  mutation moved as shape Ack queue then afterMove
  mutation dragged as shape Ack parallel
  mutation cammed as shape Ack queue then afterCam
  mutation placed as shape Ack queue refreshes snap then afterPlaced

  state bootSeq = 0
  state started = false
  // What the side panel (the phone's drawer) shows: a list tab, or one thing.
  state fleetSel = ""
  state seenAchievements = 0
  state panel = ""
  state picked = ""
  state drawerOpen = true
  state camSeq = 0
  // Phone: the native scroll over the map (offset and zoom) is the camera.
  state sl = 0
  state st = 0
  state sz = 1
  state downX = 0
  state downY = 0
  state lastTick = 0
  state hiddenToast = 0

  derive ready = boot.ready or started
  derive wide = viewport.width >= 900
  derive mapSel = sideOpen ? `${panel}:${picked}` : ""
  derive moveReply = match moved { case some(r) => r, case none => Ack(seq = 0, cam = 0, picked = "", sl = -1, st = -1, sz = -1) }
  derive tickReply = match ticked { case some(r) => r, case none => Ack(seq = 0, cam = 0, picked = "", sl = -1, st = -1, sz = -1) }
  derive camReply = match cammed { case some(r) => r, case none => Ack(seq = 0, cam = 0, picked = "", sl = -1, st = -1, sz = -1) }
  derive placedReply = match placed { case some(r) => r, case none => Ack(seq = 0, cam = 0, picked = "", sl = -1, st = -1, sz = -1) }
  // Something open: beside the map on a wide screen, in the sheet on a phone.
  derive sheetUp = top(nav).name == "fiche"
  derive sideOpen = wide ? panel != "" : sheetUp
  derive navW = wide ? 56 : 0
  derive tabName = nav.tab
  derive nativeMap = not wide
  // Px per metre of the scroll's content: the whole town fits the screen at zoom 1.
  derive z0 = snap.cityW > 0 ? min(viewport.width / snap.cityW, max(200, viewport.height - 100) / snap.cityH) : 0
  derive insetLeft = wide ? 384 : 0
  derive insetRight = wide and sideOpen ? 424 : 0
  // Where the detail panel will sit once it opens.
  derive detailRight = wide ? 424 : 0
  derive insetBottom = wide ? 0 : viewport.height * 0.55
  derive barHeight = (wide ? 50 : 48) + (snap.crisis.active ? 34 : 0)
  derive guiding = snap.guide.kind != ""
  derive hint = snap.guide.hint
  derive showToast = ready and snap.toast.id > hiddenToast and snap.toast.text != "" and not guiding
  derive placingLabel = snap.placing == "caserne" ? "caserne" : snap.placing == "police" ? "poste de police" : snap.placing == "hopital" ? "hôpital" : ""

  // The career is ready (a town chosen, or resumed from the save): start the shift once.
  task begin when ready and not started
    after(1, onReady)
  task loop when ready
    every(250, step)
  task toastTimer when showToast key=snap.toast.id
    after(4500, hideToast)
  // The sound of the moment, and a buzz for what is urgent.
  task cueSound when ready and snap.cue.id > 0 key=snap.cue.id
    after(1, playCue)
  task buzz when showToast and snap.toast.tone == "alert" key=snap.toast.id
    after(16, alertHaptic)

  // ------------------------------------------------------------ time
  action step
    let now = performanceNow()
    send ticked = tick(min(1000, max(0, now - lastTick)))
    lastTick = now
  action setSpeed(s: number)
    send commanded = setSpeed(s)
    haptic("selection")
  action togglePause
    send commanded = setPaused(not snap.paused)
  action hideToast
    hiddenToast = snap.toast.id
  action playCue
    let n = snap.cue.name
    if snap.settings.sound
      if n == "appel"
        playSound("assets/sounds/appel.wav", gain=0.55, group="phone")
      else if n == "appel_p1"
        playSound("assets/sounds/appel_p1.wav", gain=0.7, group="phone")
      else if n == "radio"
        playSound("assets/sounds/radio.wav", gain=0.45)
      else if n == "depart" and snap.settings.sirens
        playSound("assets/sounds/depart.wav", gain=0.3, group="siren")
      else if n == "crise"
        playSound("assets/sounds/crise.wav", gain=0.7)
      else if n == "gain"
        playSound("assets/sounds/gain.wav", gain=0.4)
      else if n == "promo"
        playSound("assets/sounds/promo.wav", gain=0.6)
    if n == "crise" or n == "appel_p1"
      haptic("warning")
    else if n == "gain" or n == "promo"
      haptic("success")
  action setSetting(name: string, on: bool)
    send commanded = setSetting(name, on)
  action alertHaptic
    haptic("warning")
  action onReady
    if not started
      started = true
      lastTick = performanceNow()
      // A new career opens on the build menu; a resumed one on the map.
      if not boot.ready or boot.fresh
        show("build", "")
      else
        // A resumed career opens on the map, whatever the address the browser restored.
        nav = go(nav, "/")

  // ------------------------------------------------------------ panels
  action show(kind: string, id: string)
    panel = kind
    picked = id
    drawerOpen = true
    // Back to the map's tab; on a phone the thing opens in a sheet (replacing one already up).
    if wide
      nav = select(nav, "regulation")
    else if sheetUp
      nav = push(select(back(nav), "regulation"), path("fiche", `${kind}-${id}`))
    else
      nav = push(select(nav, "regulation"), path("fiche", `${kind}-${id}`))
  action goTab(v: string)
    nav = select(nav, v)
    if v == "carriere"
      seenAchievements = snap.achievementsDone
  action follow(url: string)
    nav = go(nav, url)
  action back
    nav = back(nav)
  // Desktop shows the fleet's detail beside the list; the phone pushes a page.
  action pickFleet(s: string)
    if wide
      fleetSel = s
    else if s == ""
      nav = back(nav)
    else
      nav = push(nav, path("detail", s))
  action manageBuilding
    let target = `b-${picked}`
    panel = ""
    if wide
      fleetSel = target
      nav = select(nav, "flotte")
    else if sheetUp
      nav = push(select(back(nav), "flotte"), path("detail", target))
    else
      nav = push(select(nav, "flotte"), path("detail", target))
  action showOnMap(id: string)
    pickUnit(id)
  // The map, free of any sheet (a vehicle about to be stationed: the next tap is on a street).
  action toMap
    panel = ""
    picked = ""
    if sheetUp
      nav = select(back(nav), "regulation")
    else
      nav = select(nav, "regulation")
  action closePanel
    panel = ""
    picked = ""
    if sheetUp
      nav = back(nav)
  action toggleDrawer
    drawerOpen = not drawerOpen
  action pickCall(id: string)
    show("call", id)
    send cammed = camera("call", id, insetLeft, detailRight, barHeight, insetBottom)
  action pickUnit(id: string)
    show("unit", id)
    send cammed = camera("unit", id, insetLeft, detailRight, barHeight, insetBottom)
  action pickBuilding(id: string)
    show("building", id)
    send cammed = camera("building", id, insetLeft, detailRight, barHeight, insetBottom)
  action focusUnit
    send cammed = camera("unit", picked, insetLeft, insetRight, barHeight, insetBottom)
  action openBuild
    show("build", "")
  action openContracts
    show("contracts", "")
  action place(kind: string)
    send commanded = startPlacing(kind)
    panel = ""
    drawerOpen = false
    if sheetUp
      nav = back(nav)
  action cancelPlacing
    send commanded = cancelPlacing()
  action confirmPlacing
    send placed = confirmPlacing()
  action afterPlaced
    camSeq = placedReply.cam
    if placedReply.picked.startsWith("built:")
      show("building", placedReply.picked.slice(6))
      haptic("success")
  action openCrisis
    pickCall(snap.crisis.callId)
  action closeReport
    send commanded = closeReport()
  action skipGuide
    send commanded = skipTutorial()
  action tipSeen
    send commanded = dismissTip()
  action cancelPosting
    send commanded = cancelPosting()
  action toggleOverlay
    send placed = toggleOverlay()
  action levelSeen
    send commanded = seenLevel()
  action resetCareer
    send commanded = newCareer()
    started = false
    panel = ""
    if sheetUp
      nav = back(nav)
    bootSeq = bootSeq + 1

  // ------------------------------------------------------------ the map
  action down(e: PointerEvent)
    // Down and moves go out at once, in order: a second finger must be known before it moves.
    send dragged = touch("down", e.pointerId, e.offsetX, e.offsetY, performanceNow())
  action drag(e: PointerEvent)
    send dragged = touch("move", e.pointerId, e.offsetX, e.offsetY, performanceNow())
  action up(e: PointerEvent)
    send moved = gesture("up", e.pointerId, e.offsetX, e.offsetY, performanceNow())
  action zoomWheel(e: WheelEvent)
    send moved = wheelZoom(e.deltaY, e.offsetX, e.offsetY)
  action afterMove
    camSeq = moveReply.cam
    // On a phone, the drawer folds away once the map has been dragged.
    if moveReply.picked == "panned" and not wide and not sideOpen
      drawerOpen = false
    if moveReply.picked.startsWith("call:")
      show("call", moveReply.picked.slice(5))
    else if moveReply.picked.startsWith("unit:")
      show("unit", moveReply.picked.slice(5))
    else if moveReply.picked.startsWith("building:")
      show("building", moveReply.picked.slice(9))
    else if moveReply.picked.startsWith("built:")
      show("building", moveReply.picked.slice(6))
      haptic("success")
    else if moveReply.picked.startsWith("site:")
      show("site", moveReply.picked.slice(5))
    else if moveReply.picked.startsWith("posted:")
      show("unit", moveReply.picked.slice(7))
      haptic("success")
  action afterTick
    if tickReply.picked.startsWith("crisis:")
      send cammed = camera("call", tickReply.picked.slice(7), insetLeft, insetRight, barHeight, insetBottom)
  action afterCam
    camSeq = camReply.cam
    if nativeMap and camReply.sz > 0
      sl = camReply.sl
      st = camReply.st
      sz = camReply.sz
  action onScroll(left: number, top: number, e: ScrollEvent)
    sl = left
    st = top
    sz = e.scrollZoom
  action tapDown(e: PointerEvent)
    downX = e.clientX
    downY = e.clientY
  // A tap (not the end of a pan or a pinch) picks what is under the finger.
  action tapUp(e: PointerEvent)
    if max(e.clientX - downX, downX - e.clientX) + max(e.clientY - downY, downY - e.clientY) < 12
      send moved = gesture("tap", e.pointerId, e.clientX, e.clientY, performanceNow())
  action zoomIn
    send cammed = camera("in", "", 0, 0, 0, 0)
  action zoomOut
    send cammed = camera("out", "", 0, 0, 0, 0)
  action fit
    send cammed = camera("fit", "", 0, 0, 0, 0)

  view
    main testId="app" navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow viewport-fit="cover" color-scheme="dark" accent-color="#e6edf3" width="100%" height="100%" position="relative" overflow="hidden" display="flex" flex-direction=(wide ? "row-reverse" : "column") background-color="#0b0e12" color="#e6edf3" class=Sans
      column flex=1 min-width=0 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              column navigationKey=`${e.id}` navigationPresentation=(e.name == "fiche" ? "modal" : "") navigationDetent=(e.name == "fiche" ? "medium large" : "large") position="absolute" inset=0 overflow="hidden" background-color=(e.name == "fiche" ? "#0e1217" : "#0b0e12")
                if e.name == "regulation" and ready
                  Regulation(snap=snap, wide=wide, nat=nativeMap, sl=sl, st=st, sz=sz, z0=z0, onScroll=onScroll, tapDown=tapDown, tapUp=tapUp, barHeight=barHeight, panel=panel, picked=picked, sideOpen=sideOpen, drawerOpen=drawerOpen, guiding=guiding, hint=hint, showToast=showToast, placingLabel=placingLabel, camSeq=camSeq, mapSel=mapSel, down=down, drag=drag, up=up, zoomWheel=zoomWheel, zoomIn=zoomIn, zoomOut=zoomOut, fit=fit, toggleOverlay=toggleOverlay, cancelPosting=cancelPosting, openBuild=openBuild, confirmPlacing=confirmPlacing, cancelPlacing=cancelPlacing, skipGuide=skipGuide, tipSeen=tipSeen, hideToast=hideToast, pickCall=pickCall, toggleDrawer=toggleDrawer, closePanel=closePanel, pickUnit=pickUnit, focusUnit=focusUnit, place=place, manageBuilding=manageBuilding, toMap=toMap)
                if e.name == "fiche" and ready
                  scroll position="absolute" inset=0 padding="16px 16px 24px" testId="fiche"
                    Detail(panel=panel, picked=picked, snap=snap, closePanel=closePanel, pickUnit=pickUnit, focusUnit=focusUnit, place=place, manageBuilding=manageBuilding, toMap=toMap)
                if e.name == "flotte" and ready
                  scroll position="absolute" top=`calc(env(safe-area-inset-top) + ${barHeight}px)` left=0 right=0 bottom=0 padding=(wide ? 24 : 14) testId="view-flotte"
                    FleetView(buildings=snap.buildings, units=snap.units, seq=snap.seq, hint=snap.guide.hint, wide=wide, pushed=false, toMap=toMap, upkeep=snap.upkeepText, sel=(wide ? fleetSel : ""), pick=pickFleet, showOnMap=showOnMap)
                if e.name == "detail"
                  column position="absolute" top=`calc(env(safe-area-inset-top) + ${barHeight}px)` left=0 right=0 bottom=0
                    header display="flex" align-items="center" gap=8 padding="6px 14px" border-bottom="1px solid #252c36"
                      button id="close" press=back appearance="none" display="flex" align-items="center" gap=4 padding="6px 0" testId="fleet-back"
                        Icon(name="chevron-left", size=14, color="#9aa4b2")
                        text "Flotte" font-size="0.84rem" color="#9aa4b2"
                      text (e.params.sel.startsWith("b-") ? "Base" : "Véhicule") role="heading" aria-level=2 font-size="0.9rem" font-weight=600
                    scroll flex=1 min-height=0 padding=14
                      FleetView(buildings=snap.buildings, units=snap.units, seq=snap.seq, hint=snap.guide.hint, wide=false, pushed=true, toMap=toMap, upkeep=snap.upkeepText, sel=e.params.sel, pick=pickFleet, showOnMap=showOnMap)
                if e.name == "carriere" and ready
                  scroll position="absolute" top=`calc(env(safe-area-inset-top) + ${barHeight}px)` left=0 right=0 bottom=0 padding=(wide ? 24 : 14) testId="view-carriere"
                    CareerView(level=snap.level, maxLevel=snap.maxLevel, xpText=snap.xpText, progress=snap.levelProgress, reputation=snap.reputation, coverage=snap.coverage, repEffect=snap.repEffect, difficulty=snap.difficulty, stats=snap.stats, city=snap.city, rank=snap.rank, rankIcon=snap.rankIcon, achievements=snap.achievements, achievementsDone=snap.achievementsDone, wide=wide, settings=snap.settings, setSetting=setSetting, reset=resetCareer)
                if e.name == "journal" and ready
                  scroll position="absolute" top=`calc(env(safe-area-inset-top) + ${barHeight}px)` left=0 right=0 bottom=0 padding=(wide ? 24 : 14) testId="view-journal"
                    JournalView(seq=snap.seq, date=snap.date, bulletin=snap.weather.bulletin, weatherIcon=snap.weather.icon)
      // The tabs: a rail drawn by the game on a wide screen; the platform's tab bar on a phone
      // (UIKit's in the iOS app).
      row role="tablist" aria-label="Vues" appearance=(wide ? "none" : "auto") display=(ready ? "flex" : "none") flex-direction=(wide ? "column" : "row") flex-shrink=0 width=(wide ? "56px" : "auto") gap=(wide ? 4 : 0) padding-top=(wide ? `calc(env(safe-area-inset-top) + ${barHeight + 8}px)` : "0px") background-color="#0b0e12" border-right=(wide ? "1px solid #252c36" : "none") border-top=(wide ? "none" : "1px solid #252c36") testId="nav"
        for v in ["regulation", "flotte", "carriere", "journal"] key=v
          button role="tab" aria-controls=`panel-${v}` aria-selected=(tabName == v) aria-label=tabLabel(v) title=tabLabel(v) press=goTab(v) position="relative" flex=(wide ? "none" : 1) height=(wide ? "48px" : "auto") padding=(wide ? "0px" : "6px 0px 4px") display="flex" flex-direction="column" align-items="center" justify-content="center" gap=2 border-left-width=(wide ? 2 : 0) border-left-style="solid" border-left-color=(wide and tabName == v ? "#e6edf3" : "transparent") box-shadow=(hint == "buy-VSAV" and v == "flotte" and tabName != "flotte" ? "inset 0 0 0 2px #e6edf3" : "none") testId=`nav-${v}`
            if wide
              Icon(name=tabIcon(v), size=19, color=(tabName == v ? "#e6edf3" : "#808b9c"))
            else
              image tabSymbol(v) width=22 height=22 color=(tabName == v ? "#e6edf3" : "#808b9c")
              text tabLabel(v) font-size="0.62rem" font-weight=600 color=(tabName == v ? "#e6edf3" : "#808b9c") white-space="nowrap"
            if v == "regulation" and snap.newCalls > 0
              row position="absolute" top=(wide ? 6 : 2) right=(wide ? 6 : "calc(50% - 24px)") padding="1px 4px" border-radius=8 background-color="#f2555a" aria-label=`${snap.newCalls} appels à qualifier` testId="badge-calls"
                text `${snap.newCalls}` class=Mono font-size="0.6rem" font-weight=600 color="#0b0e12"
            if v == "carriere" and snap.achievementsDone > seenAchievements and tabName != "carriere"
              row position="absolute" top=(wide ? 9 : 4) right=(wide ? 10 : "calc(50% - 18px)") width=7 height=7 border-radius=4 background-color="#f0a531" aria-label="Nouveau succès"
      // Overlays over every tab: the top bar, the crisis strip, cards, and the town picker.
      if ready
        column position="absolute" top=0 left=navW right=0
          TopBar(snap=snap, wide=wide, setSpeed=setSpeed, togglePause=togglePause, openContracts=openContracts)
          if snap.crisis.active
            view margin-top=`calc(env(safe-area-inset-top) + ${wide ? 50 : 48}px)`
              CrisisBar(c=snap.crisis, open=openCrisis)
      if snap.showUnlock and ready
        UnlockCard(unlock=snap.unlock, done=levelSeen)
      if snap.report.show and not snap.showUnlock and ready
        CrisisReportCard(r=snap.report, done=closeReport)
      // exact-accept lower-screen-by-state
      if not ready
        column position="absolute" inset=0 background-color="#0b0e12"
          CityPicker(seed=time.seed, epoch=time.epochAtZero, ready=onReady)

keyframes drop
  from opacity=0 translate="0px -8px"
keyframes slide
  from opacity=0 translate="16px 0px"

// ---------------------------------------------------------------- assembly

fn tabLabel(v: string): string = v == "regulation" ? "Régulation" : v == "flotte" ? "Flotte" : v == "carriere" ? "Carrière" : "Main courante"
fn tabIcon(v: string): string = v == "regulation" ? "calls" : v == "flotte" ? "fleet" : v == "carriere" ? "level" : "log"
fn tabSymbol(v: string): string = v == "regulation" ? "symbol:phone" : v == "flotte" ? "symbol:people" : v == "carriere" ? "symbol:star" : "symbol:list"

// The regulation tab: the map, its tools, the call queue and the one thing open.
component Regulation
  props
    snap: Snap
    wide: bool
    nat: bool
    sl: number
    st: number
    sz: number
    z0: number
    onScroll: action
    tapDown: action
    tapUp: action
    barHeight: number
    panel: string
    picked: string
    sideOpen: bool
    drawerOpen: bool
    guiding: bool
    hint: string
    showToast: bool
    placingLabel: string
    camSeq: number
    mapSel: string
    down: action
    drag: action
    up: action
    zoomWheel: action
    zoomIn: action
    zoomOut: action
    fit: action
    toggleOverlay: action
    cancelPosting: action
    openBuild: action
    confirmPlacing: action
    cancelPlacing: action
    skipGuide: action
    tipSeen: action
    hideToast: action
    pickCall: action
    toggleDrawer: action
    closePanel: action
    pickUnit: action
    focusUnit: action
    place: action
    manageBuilding: action
    toMap: action
  view
    view position="absolute" inset=0
      canvas surface=city(camSeq, snap.night, (nat ? sl : -1), st, sz, z0) position="absolute" left=0 top=0 width="100%" height="100%" aria-hidden=true testId="map-city"
      canvas surface=live(mapSel, (nat ? sl : -1), st, sz, z0) position="absolute" left=0 top=0 width="100%" height="100%" touch-action="none" pointerdown=down pointermove=drag pointerup=up wheel=zoomWheel role="img" aria-label=`Carte de ${snap.city}` testId="map"
      // Phone: an invisible zoomable scroll over the map, driven by the platform
      // (UIScrollView on iOS): pinch, pan, momentum, bounce and double tap are native.
      if nat and z0 > 0
        scroll position="absolute" left=0 top=0 width="100%" height="100%" -exact-min-zoom=1 -exact-max-zoom=(3 / z0) scrollLeft=sl scrollTop=st scrollZoom=sz scroll-behavior="smooth" scroll=onScroll aria-label=`Carte de ${snap.city}` testId="map-touch"
          view width=`${snap.cityW * z0}px` height=`${snap.cityH * z0}px` pointerdown=tapDown pointerup=tapUp
      // Map tools: zoom, overview, coverage, build.
      column position="absolute" right=(wide ? (sideOpen ? 436 : 12) : 10) top=`calc(env(safe-area-inset-top) + ${barHeight + 10}px)` gap=6
        button press=zoomIn aria-label="Zoomer" class=IconButton testId="zoom-in"
          Icon(name="plus", size=16, color="#e6edf3")
        button press=zoomOut aria-label="Dézoomer" class=IconButton testId="zoom-out"
          Icon(name="minus", size=16, color="#e6edf3")
        button press=fit aria-label="Vue d'ensemble" class=IconButton testId="fit"
          Icon(name="target", size=16, color="#e6edf3")
        button press=toggleOverlay aria-label=(snap.overlay ? "Masquer la couverture" : "Afficher la couverture") aria-pressed=snap.overlay class=IconButton background-color=(snap.overlay ? "#1f3a26" : "#11151b") border-color=(snap.overlay ? "#3fb950" : "#252c36") testId="overlay"
          Icon(name="layers", size=16, color=(snap.overlay ? "#3fb950" : "#e6edf3"))
        button press=openBuild aria-label="Construire" class=IconButton background-color="#e6edf3" box-shadow=(hint == "open-build" ? "0 0 0 2px #e6edf3" : "none") testId="open-build"
          Icon(name="build", size=18, color="#0b0e12")
      if snap.posting != ""
        row position="absolute" top=`calc(env(safe-area-inset-top) + ${barHeight + 10}px)` left=(wide ? 396 : 10) right=(wide ? 64 : 60) gap=10 align-items="center" padding="10px 12px" background-color="#e6edf3" border-radius=4 testId="posting"
          Icon(name="target", size=16, color="#0b0e12")
          text `Touchez une rue où poster ${snap.posting}` font-size="0.85rem" font-weight=600 color="#0b0e12" flex=1
          button press=cancelPosting appearance="none" padding="4px 8px" border="1px solid #0b0e12" border-radius=3 testId="posting-cancel"
            text "Annuler" font-size="0.78rem" color="#0b0e12"
      if snap.placing != ""
        view position="absolute" top=`calc(env(safe-area-inset-top) + ${barHeight + 10}px)` left=(wide ? 396 : 10) right=(wide ? 64 : 60)
          PlacingBanner(label=placingLabel, aimed=snap.aimed, aimText=snap.aimText, price=snap.placingPrice, confirm=confirmPlacing, cancel=cancelPlacing)
      if guiding and snap.placing == "" and not snap.showUnlock
        view position="absolute" top=`calc(env(safe-area-inset-top) + ${barHeight + 10}px)` left=(wide ? 396 : 10) right=(wide ? (sideOpen ? 488 : 64) : 60) display="flex" justify-content="center" pointer-events="none"
          view pointer-events="auto" max-width="30rem" width="100%"
            GuideCard(g=snap.guide, skip=skipGuide, ok=tipSeen)
      if showToast and snap.placing == ""
        view position="absolute" top=`calc(env(safe-area-inset-top) + ${barHeight + 10}px)` left=(wide ? 396 : 10) right=(wide ? (sideOpen ? 488 : 64) : 60) display="flex" justify-content="center" pointer-events="none"
          row press=hideToast pointer-events="auto" gap=10 align-items="center" padding="9px 12px" max-width="34rem" background-color="#11151b" border="1px solid #252c36" border-left-width=3 border-left-style="solid" border-left-color=toneColor(snap.toast.tone) border-radius=4 animation="drop 260ms cubic-bezier(0.2, 0.8, 0.2, 1)" testId="toast"
            text snap.toast.at class=Mono font-size="0.7rem" color="#808b9c"
            text snap.toast.text font-size="0.86rem"
      if wide
        // Left: the calls.
        column position="absolute" top=`calc(env(safe-area-inset-top) + ${barHeight}px)` left=0 bottom=0 width="24rem" background-color="#0e1217" border-right="1px solid #252c36" testId="rail"
          CallsHeader(calls=snap.calls.length, fresh=snap.newCalls)
          scroll flex=1 min-height=0 padding=12
            CallQueue(calls=snap.calls, closed=snap.closed, selected=(panel == "call" ? picked : ""), pick=pickCall, firstBuilding=snap.firstBuilding, hint=snap.guide.hint)
        // Right: the one thing open.
        if sideOpen
          column position="absolute" top=`calc(env(safe-area-inset-top) + ${barHeight}px)` right=0 bottom=0 width="26.5rem" background-color="#0e1217" border-left="1px solid #252c36" animation="slide 220ms cubic-bezier(0.2, 0.8, 0.2, 1)" testId="side"
            scroll flex=1 min-height=0 padding=16
              Detail(panel=panel, picked=picked, snap=snap, closePanel=closePanel, pickUnit=pickUnit, focusUnit=focusUnit, place=place, manageBuilding=manageBuilding, toMap=toMap)
      else
        // Phone: one drawer for the calls and the thing open.
        column position="absolute" left=0 right=0 bottom=0 max-height=(drawerOpen ? "55%" : "auto") background-color="#0e1217" border-top="1px solid #30394a" testId="drawer"
          button press=toggleDrawer appearance="none" display="flex" justify-content="center" padding-top=8 padding-bottom=4 aria-label=(drawerOpen ? "Réduire le panneau" : "Ouvrir le panneau") aria-expanded=drawerOpen testId="drawer-handle"
            view width=36 height=4 border-radius=2 background-color="#4b5668"
          CallsHeader(calls=snap.calls.length, fresh=snap.newCalls)
          if drawerOpen
            scroll flex=1 min-height=0 padding="8px 12px 12px"
              CallQueue(calls=snap.calls, closed=snap.closed, selected=(panel == "call" ? picked : ""), pick=pickCall, firstBuilding=snap.firstBuilding, hint=snap.guide.hint)

component CallsHeader
  props
    calls: number
    fresh: number
  view
    row align-items="center" gap=8 padding="10px 14px" border-bottom="1px solid #252c36"
      Icon(name="calls", size=15, color="#e6edf3")
      text "Appels" font-size="0.84rem" font-weight=600 flex=1
      if calls > 0
        text `${calls}` class=Mono font-size="0.66rem" font-weight=600 padding="1px 5px" border-radius=2 background-color=(fresh > 0 ? "#f2555a" : "#30394a") color=(fresh > 0 ? "#0b0e12" : "#e6edf3") testId="calls-count"

// The one thing the side panel shows.
component Detail
  props
    panel: string
    picked: string
    snap: Snap
    closePanel: action
    pickUnit: action
    focusUnit: action
    place: action
    manageBuilding: action
    toMap: action
  view
    column
      if panel == "call"
        match first(snap.calls.filter(c => c.id == picked))
          case some(c)
            CallSheet(c=c, seq=snap.seq, close=closePanel, pickUnit=pickUnit, hint=snap.guide.hint)
          case none
            CallGone(close=closePanel)
      if panel == "unit"
        match first(snap.units.filter(u => u.id == picked))
          case some(u)
            UnitCard(u=u, dismiss=closePanel, see=focusUnit, posted=toMap)
          case none
            CallGone(close=closePanel)
      if panel == "building"
        match first(snap.buildings.filter(b => b.id == picked))
          case some(b)
            BuildingBrief(b=b, close=closePanel, manage=manageBuilding)
          case none
            CallGone(close=closePanel)
      if panel == "site"
        match first(snap.sites.filter(s => `${s.index}` == picked))
          case some(s)
            SiteSheet(s=s, dismiss=closePanel)
          case none
            CallGone(close=closePanel)
      if panel == "build"
        BuildMenu(options=snap.build, first=snap.firstBuilding, place=place, close=closePanel)
      if panel == "contracts"
        ContractsPanel(contracts=snap.contracts, streak=snap.streak, day=snap.day, date=snap.date, bulletin=snap.weather.bulletin, close=closePanel)

// What a closed panel's target leaves behind (a call that ended, a vehicle sold).
component CallGone
  props
    close: action
  view
    column gap=10 padding="20px 4px" align-items="flex-start"
      text "Cet élément n'est plus actif." color="#9aa4b2"
      button press=close appearance="none" padding="6px 0" testId="gone-close"
        text "Fermer" class=Mono font-size="0.8rem" color="#e6edf3"
