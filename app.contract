// Emergency Sim — the root: session state, the map, and where each panel goes.
// Every screen lives in ui/; the data module (app.ts → src/, sim/, render/)
// runs the career and draws the map's two canvases.
use Ack, Boot, Snap from "./ui/model.contract"
use Icon from "./ui/icons.contract"
use Sans, Mono, IconButton, toneColor from "./ui/theme.contract"
use TopBar from "./ui/topbar.contract"
use CallQueue from "./ui/calls.contract"
use CallSheet from "./ui/call-sheet.contract"
use UnitCard from "./ui/fleet.contract"
use BuildMenu, PlacingBanner, BuildingBrief, SiteSheet from "./ui/build.contract"
use UnlockCard, CareerView from "./ui/career.contract"
use Nav from "./ui/nav.contract"
use FleetView from "./ui/fleet-view.contract"
use JournalView from "./ui/journal.contract"
use CityPicker from "./ui/city-picker.contract"
use ContractsPanel from "./ui/contracts.contract"
use GuideCard from "./ui/tutorial.contract"
use CrisisBar, CrisisReportCard from "./ui/major.contract"

shape Time
  seed: number
  epochAtZero: number

shape Viewport
  width: number
  height: number

component EmergencySim
  resource time = exactTime() as shape Time
  resource viewport = exactViewport() as shape Viewport
  resource boot = boot(bootSeq, time.epochAtZero) as shape Boot else empty() transient
  resource snap = snapshot() as shape Snap else empty() transient
  mutation ticked as shape Ack refreshes snap then afterTick
  mutation commanded as shape Ack queue refreshes snap
  mutation moved as shape Ack queue then afterMove
  mutation cammed as shape Ack queue then afterCam
  mutation placed as shape Ack queue refreshes snap then afterPlaced

  state bootSeq = 0
  state started = false
  // What the side panel (the phone's drawer) shows: a list tab, or one thing.
  // The view on screen: the map console, the fleet, the career, the log.
  state view = "regulation"
  state fleetSel = ""
  state seenAchievements = 0
  state panel = ""
  state picked = ""
  state drawerOpen = true
  state camSeq = 0
  state lastTick = 0
  state hiddenToast = 0

  derive ready = boot.ready or started
  derive wide = viewport.width >= 900
  derive mapSel = panel == "" ? "" : `${panel}:${picked}`
  derive moveReply = match moved { case some(r) => r, case none => Ack(seq = 0, cam = 0, picked = "") }
  derive tickReply = match ticked { case some(r) => r, case none => Ack(seq = 0, cam = 0, picked = "") }
  derive camReply = match cammed { case some(r) => r, case none => Ack(seq = 0, cam = 0, picked = "") }
  derive placedReply = match placed { case some(r) => r, case none => Ack(seq = 0, cam = 0, picked = "") }
  derive sideOpen = panel != ""
  derive navW = wide ? 56 : 0
  derive navH = wide ? "0px" : "calc(57px + env(safe-area-inset-bottom))"
  derive insetLeft = wide ? 56 + 384 : 0
  derive insetRight = wide and sideOpen ? 424 : 0
  // Where the detail panel will sit once it opens.
  derive detailRight = wide ? 424 : 0
  derive insetBottom = wide ? 0 : viewport.height * 0.55 + 57
  derive barHeight = (wide ? 50 : 48) + (snap.crisis.active ? 34 : 0)
  derive guiding = snap.guide.kind != ""
  derive hint = snap.guide.hint
  derive showToast = ready and snap.toast.id > hiddenToast and snap.toast.text != "" and not guiding
  derive placingLabel = snap.placing == "caserne" ? "caserne" : snap.placing == "police" ? "poste de police" : snap.placing == "hopital" ? "hôpital" : ""

  task loop when ready
    every(250, step)
  task toastTimer when showToast key=snap.toast.id
    after(4500, hideToast)
  task buzz when showToast and snap.toast.tone == "alert" key=snap.toast.id
    after(16, alertHaptic)

  // ------------------------------------------------------------ time
  action step
    let now = performanceNow()
    send ticked = tick(min(1000, max(0, now - lastTick)))
    lastTick = now
  action setSpeed(s: number)
    send commanded = setSpeed(s)
    haptic("selection")
  action togglePause
    send commanded = setPaused(not snap.paused)
  action hideToast
    hiddenToast = snap.toast.id
  action alertHaptic
    haptic("warning")
  action onReady
    started = true
    lastTick = performanceNow()
    panel = "build"
    picked = ""

  // ------------------------------------------------------------ panels
  action show(kind: string, id: string)
    panel = kind
    picked = id
    drawerOpen = true
  action go(v: string)
    view = v
    if v == "carriere"
      seenAchievements = snap.achievementsDone
  action pickFleet(s: string)
    fleetSel = s
  action manageBuilding
    fleetSel = `b:${picked}`
    panel = ""
    view = "flotte"
  action showOnMap(id: string)
    view = "regulation"
    pickUnit(id)
  action closePanel
    panel = ""
    picked = ""
  action toggleDrawer
    drawerOpen = not drawerOpen
  action pickCall(id: string)
    show("call", id)
    send cammed = camera("call", id, insetLeft, detailRight, barHeight, insetBottom)
  action pickUnit(id: string)
    show("unit", id)
    send cammed = camera("unit", id, insetLeft, detailRight, barHeight, insetBottom)
  action pickBuilding(id: string)
    show("building", id)
    send cammed = camera("building", id, insetLeft, detailRight, barHeight, insetBottom)
  action focusUnit
    send cammed = camera("unit", picked, insetLeft, insetRight, barHeight, insetBottom)
  action openBuild
    show("build", "")
  action openContracts
    view = "regulation"
    show("contracts", "")
  action place(kind: string)
    send commanded = startPlacing(kind)
    panel = ""
    drawerOpen = false
  action cancelPlacing
    send commanded = cancelPlacing()
  action confirmPlacing
    send placed = confirmPlacing()
  action afterPlaced
    camSeq = placedReply.cam
    if placedReply.picked.startsWith("built:")
      show("building", placedReply.picked.slice(6))
      haptic("success")
  action openCrisis
    view = "regulation"
    pickCall(snap.crisis.callId)
  action closeReport
    send commanded = closeReport()
  action skipGuide
    send commanded = skipTutorial()
  action tipSeen
    send commanded = dismissTip()
  action toggleOverlay
    send placed = toggleOverlay()
  action levelSeen
    send commanded = seenLevel()
  action resetCareer
    send commanded = newCareer()
    started = false
    panel = ""
    bootSeq = bootSeq + 1

  // ------------------------------------------------------------ the map
  action down(e: PointerEvent)
    send moved = gesture("down", e.pointerId, e.offsetX, e.offsetY)
  action drag(e: PointerEvent)
    send moved = gesture("move", e.pointerId, e.offsetX, e.offsetY)
  action up(e: PointerEvent)
    send moved = gesture("up", e.pointerId, e.offsetX, e.offsetY)
  action zoomWheel(e: WheelEvent)
    send moved = wheelZoom(e.deltaY, e.offsetX, e.offsetY)
  action afterMove
    camSeq = moveReply.cam
    if moveReply.picked.startsWith("call:")
      show("call", moveReply.picked.slice(5))
    else if moveReply.picked.startsWith("unit:")
      show("unit", moveReply.picked.slice(5))
    else if moveReply.picked.startsWith("building:")
      show("building", moveReply.picked.slice(9))
    else if moveReply.picked.startsWith("built:")
      show("building", moveReply.picked.slice(6))
      haptic("success")
    else if moveReply.picked.startsWith("site:")
      show("site", moveReply.picked.slice(5))
  action afterTick
    if tickReply.picked.startsWith("crisis:")
      send cammed = camera("call", tickReply.picked.slice(7), insetLeft, insetRight, barHeight, insetBottom)
  action afterCam
    camSeq = camReply.cam
  action zoomIn
    send cammed = camera("in", "", 0, 0, 0, 0)
  action zoomOut
    send cammed = camera("out", "", 0, 0, 0, 0)
  action fit
    send cammed = camera("fit", "", 0, 0, 0, 0)

  view
    main testId="app" color-scheme="dark" width="100%" height="100%" position="relative" overflow="hidden" background-color="#0b0e12" color="#e6edf3" class=Sans
      // exact-accept lower-screen-by-state
      if not ready
        CityPicker(seed=time.seed, epoch=time.epochAtZero, ready=onReady)
      else
        canvas surface=city(camSeq) position="absolute" left=0 top=0 width="100%" height="100%" aria-hidden=true testId="map-city"
        canvas surface=live(mapSel) position="absolute" left=0 top=0 width="100%" height="100%" touch-action="none" pointerdown=down pointermove=drag pointerup=up wheel=zoomWheel role="img" aria-label=`Carte de ${snap.city}` testId="map"
        column position="absolute" top=0 left=0 right=0
          TopBar(snap=snap, wide=wide, setSpeed=setSpeed, togglePause=togglePause, openContracts=openContracts)
          if snap.crisis.active
            view margin-top=`calc(env(safe-area-inset-top) + ${wide ? 50 : 48}px)`
              CrisisBar(c=snap.crisis, open=openCrisis)

        // Map tools: zoom, overview, build.
        column position="absolute" right=(wide ? (sideOpen ? 436 : 12) : 10) top=`calc(env(safe-area-inset-top) + ${barHeight + 10}px)` gap=6
          button press=zoomIn aria-label="Zoomer" class=IconButton testId="zoom-in"
            Icon(name="plus", size=16, color="#e6edf3")
          button press=zoomOut aria-label="Dézoomer" class=IconButton testId="zoom-out"
            Icon(name="minus", size=16, color="#e6edf3")
          button press=fit aria-label="Vue d'ensemble" class=IconButton testId="fit"
            Icon(name="target", size=16, color="#e6edf3")
          button press=toggleOverlay aria-label=(snap.overlay ? "Masquer la couverture" : "Afficher la couverture") aria-pressed=snap.overlay class=IconButton background-color=(snap.overlay ? "#1f3a26" : "#11151b") border-color=(snap.overlay ? "#3fb950" : "#252c36") testId="overlay"
            Icon(name="layers", size=16, color=(snap.overlay ? "#3fb950" : "#e6edf3"))
          button press=openBuild aria-label="Construire" class=IconButton background-color="#e6edf3" box-shadow=(hint == "open-build" ? "0 0 0 2px #e6edf3" : "none") testId="open-build"
            Icon(name="build", size=18, color="#0b0e12")

        if snap.placing != ""
          view position="absolute" top=`calc(env(safe-area-inset-top) + ${barHeight + 10}px)` left=(wide ? 452 : 10) right=(wide ? 64 : 60)
            PlacingBanner(label=placingLabel, aimed=snap.aimed, aimText=snap.aimText, price=snap.placingPrice, confirm=confirmPlacing, cancel=cancelPlacing)

        if guiding and snap.placing == "" and not snap.showUnlock
          view position="absolute" top=`calc(env(safe-area-inset-top) + ${barHeight + 10}px)` left=(wide ? 452 : 10) right=(wide ? (sideOpen ? 488 : 64) : 60) display="flex" justify-content="center" pointer-events="none"
            view pointer-events="auto" max-width="30rem" width="100%"
              GuideCard(g=snap.guide, skip=skipGuide, ok=tipSeen)

        if showToast and snap.placing == ""
          view position="absolute" top=`calc(env(safe-area-inset-top) + ${barHeight + 10}px)` left=(wide ? 452 : 10) right=(wide ? (sideOpen ? 488 : 64) : 60) display="flex" justify-content="center" pointer-events="none"
            row press=hideToast pointer-events="auto" gap=10 align-items="center" padding="9px 12px" max-width="34rem" background-color="#11151b" border="1px solid #252c36" border-left-width=3 border-left-style="solid" border-left-color=toneColor(snap.toast.tone) border-radius=4 animation="drop 260ms cubic-bezier(0.2, 0.8, 0.2, 1)" testId="toast"
              text snap.toast.at class=Mono font-size="0.7rem" color="#6b7686"
              text snap.toast.text font-size="0.86rem"

        if wide
          // Left: the calls.
          column position="absolute" top=`calc(env(safe-area-inset-top) + ${barHeight}px)` left=56 bottom=0 width="24rem" background-color="#0e1217" border-right="1px solid #252c36" testId="rail"
            CallsHeader(calls=snap.calls.length, fresh=snap.newCalls)
            scroll flex=1 min-height=0 padding=12
              CallQueue(calls=snap.calls, closed=snap.closed, selected=(panel == "call" ? picked : ""), pick=pickCall, firstBuilding=snap.firstBuilding, hint=snap.guide.hint)
          // Right: the one thing open.
          if sideOpen
            column position="absolute" top=`calc(env(safe-area-inset-top) + ${barHeight}px)` right=0 bottom=0 width="26.5rem" background-color="#0e1217" border-left="1px solid #252c36" animation="slide 220ms cubic-bezier(0.2, 0.8, 0.2, 1)" testId="side"
              scroll flex=1 min-height=0 padding=16
                Detail(panel=panel, picked=picked, snap=snap, closePanel=closePanel, pickUnit=pickUnit, focusUnit=focusUnit, place=place, manageBuilding=manageBuilding)
        else
          // Phone: one drawer for lists and details.
          column position="absolute" left=0 right=0 bottom=navH max-height=(drawerOpen ? "55%" : "auto") background-color="#0e1217" border-top="1px solid #30394a" testId="drawer"
            button press=toggleDrawer appearance="none" display="flex" justify-content="center" padding-top=8 padding-bottom=4 aria-label=(drawerOpen ? "Réduire le panneau" : "Ouvrir le panneau") aria-expanded=drawerOpen testId="drawer-handle"
              view width=36 height=4 border-radius=2 background-color="#4b5668"
            if sideOpen and drawerOpen
              scroll flex=1 min-height=0 padding="6px 14px 14px"
                Detail(panel=panel, picked=picked, snap=snap, closePanel=closePanel, pickUnit=pickUnit, focusUnit=focusUnit, place=place, manageBuilding=manageBuilding)
            else
              CallsHeader(calls=snap.calls.length, fresh=snap.newCalls)
              if drawerOpen
                scroll flex=1 min-height=0 padding="8px 12px 12px"
                  CallQueue(calls=snap.calls, closed=snap.closed, selected=(panel == "call" ? picked : ""), pick=pickCall, firstBuilding=snap.firstBuilding, hint=snap.guide.hint)

        if view != "regulation"
          scroll position="absolute" top=`calc(env(safe-area-inset-top) + ${barHeight}px)` left=navW right=0 bottom=navH padding=(wide ? 24 : 14) background-color="#0b0e12" testId=`view-${view}`
            if view == "flotte"
              FleetView(buildings=snap.buildings, units=snap.units, seq=snap.seq, hint=snap.guide.hint, wide=wide, upkeep=snap.upkeepText, sel=fleetSel, pick=pickFleet, showOnMap=showOnMap)
            if view == "carriere"
              CareerView(level=snap.level, maxLevel=snap.maxLevel, xpText=snap.xpText, progress=snap.levelProgress, reputation=snap.reputation, coverage=snap.coverage, stats=snap.stats, city=snap.city, rank=snap.rank, rankIcon=snap.rankIcon, achievements=snap.achievements, achievementsDone=snap.achievementsDone, wide=wide, reset=resetCareer)
            if view == "journal"
              JournalView(seq=snap.seq, date=snap.date, bulletin=snap.weather.bulletin, weatherIcon=snap.weather.icon)
        Nav(view=view, wide=wide, fresh=snap.newCalls, free=snap.free, news=(snap.achievementsDone > seenAchievements and view != "carriere"), hint=hint, top=`calc(env(safe-area-inset-top) + ${barHeight}px)`, go=go)

        if snap.showUnlock
          UnlockCard(unlock=snap.unlock, done=levelSeen)
        if snap.report.show and not snap.showUnlock
          CrisisReportCard(r=snap.report, done=closeReport)

keyframes drop
  from opacity=0 translate="0px -8px"
keyframes slide
  from opacity=0 translate="16px 0px"

// ---------------------------------------------------------------- assembly

component CallsHeader
  props
    calls: number
    fresh: number
  view
    row align-items="center" gap=8 padding="10px 14px" border-bottom="1px solid #252c36"
      Icon(name="calls", size=15, color="#e6edf3")
      text "Appels" font-size="0.84rem" font-weight=600 flex=1
      if calls > 0
        text `${calls}` class=Mono font-size="0.66rem" font-weight=600 padding="1px 5px" border-radius=2 background-color=(fresh > 0 ? "#f2555a" : "#30394a") color=(fresh > 0 ? "#0b0e12" : "#e6edf3") testId="calls-count"

// The one thing the side panel shows.
component Detail
  props
    panel: string
    picked: string
    snap: Snap
    closePanel: action
    pickUnit: action
    focusUnit: action
    place: action
    manageBuilding: action
  view
    column
      if panel == "call"
        match first(snap.calls.filter(c => c.id == picked))
          case some(c)
            CallSheet(c=c, seq=snap.seq, close=closePanel, pickUnit=pickUnit, hint=snap.guide.hint)
          case none
            CallGone(close=closePanel)
      if panel == "unit"
        match first(snap.units.filter(u => u.id == picked))
          case some(u)
            UnitCard(u=u, dismiss=closePanel, focus=focusUnit)
          case none
            CallGone(close=closePanel)
      if panel == "building"
        match first(snap.buildings.filter(b => b.id == picked))
          case some(b)
            BuildingBrief(b=b, close=closePanel, manage=manageBuilding)
          case none
            CallGone(close=closePanel)
      if panel == "site"
        match first(snap.sites.filter(s => `${s.index}` == picked))
          case some(s)
            SiteSheet(s=s, dismiss=closePanel)
          case none
            CallGone(close=closePanel)
      if panel == "build"
        BuildMenu(options=snap.build, first=snap.firstBuilding, place=place, close=closePanel)
      if panel == "contracts"
        ContractsPanel(contracts=snap.contracts, streak=snap.streak, day=snap.day, date=snap.date, bulletin=snap.weather.bulletin, close=closePanel)

// What a closed panel's target leaves behind (a call that ended, a vehicle sold).
component CallGone
  props
    close: action
  view
    column gap=10 padding="20px 4px" align-items="flex-start"
      text "Cet élément n'est plus actif." color="#9aa4b2"
      button press=close appearance="none" padding="6px 0" testId="gone-close"
        text "Fermer" class=Mono font-size="0.8rem" color="#e6edf3"
